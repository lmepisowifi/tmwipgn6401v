@@ -2438,7 +2439,14 @@ function startCoinPoll() {
               }
             }
 
-            if (typeof d.remaining === 'number' && Math.abs(d.remaining - _coinWinLeft) > 2) {
+            // Resync/restart the countdown whenever a coin was just detected,
+            // not only when the reported remaining differs from our local
+            // value by more than 2s — a coin dropped while the window's
+            // fresh reset value happened to be within 2s of where the local
