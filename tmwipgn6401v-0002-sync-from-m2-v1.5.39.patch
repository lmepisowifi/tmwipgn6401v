               _coinInitialLeft = d.remaining;
               _coinStartTime = Date.now();
               _coinWinLeft = d.remaining;
@@ -2571,6 +2579,26 @@ function doCoinDone() {
 
   _isFinalizing = true;
   if (_coinWinID) { clearInterval(_coinWinID); _coinWinID = null; }
+  // Cancel any force-close timer left over from the coin window having
+  // already hit 0 before Done was clicked. Left alone, it could still fire
+  // after we've asked the server to finalize — tearing down the still-
+  // running poll loop and showing a false "Coinslot session expired." error
+  // even though the time was (or was about to be) granted successfully.
+  if (_coinExpireTimeout) { clearTimeout(_coinExpireTimeout); _coinExpireTimeout = null; }
+  // Replace it with a finalize-specific watchdog so a customer never gets
+  // stuck on "Finishing up." forever if the server genuinely never answers.
+  // stopCoinPoll() (called by the poll loop's 'complete'/'expired' handling)
+  // clears this the moment a real terminal status arrives.
+  _coinExpireTimeout = setTimeout(function() {
+    _coinExpireTimeout = null;
+    if (!_coinSID) return; // poll already reached a terminal status
+    stopCoinPoll();
+    _pauseCoinBgMusic();
+    _hideCoinButtons();
+    _isFinalizing = false;
+    toastr.warning('Still finishing up — check your session status.');
+    setTimeout(function() { _coinSID = null; closeCoinModalUI(); checkStatus(); }, 2000);
+  }, 15000);
   // If we were mid-reconnect, tear down the banner — the user chose to bank
   // their coins, so "Finishing up." should replace the reconnecting message.
   exitCoinReconnecting();
