   return res.join(' ');
 }
 
+/* Shows/hides the small "Xh Ym expires in Xh Ym" line above a countdown
+   for a customer whose remaining time includes a validity-limited (rate
+   expiry) chunk - see ratevalidity.sh / status.sh's expiring_remaining
+   and expiring_deadline_secs fields. deadlineSecs is how many seconds are
+   left before that chunk's deadline, NOT a calendar timestamp - the
+   backend's deadline is tracked against device uptime (see
+   ratevalidity.sh), which has no meaning to the browser, so status.sh
+   already converts it to a relative countdown before it gets here.
+   Hidden entirely for a purely no-expiry balance (remainSecs/deadlineSecs
+   both 0), which is the common case. */
+function updateExpiryNotice(elId, remainSecs, deadlineSecs) {
+  var el = document.getElementById(elId);
+  if (!el) return;
+  if (!(remainSecs > 0) || !(deadlineSecs > 0)) {
+    el.style.display = 'none';
+    return;
+  }
+  var mins = Math.max(1, Math.ceil(remainSecs / 60));
+  var dmins = Math.max(1, Math.ceil(deadlineSecs / 60));
+  el.textContent = fmtMinutesLong(mins) + ' expires in ' + fmtMinutesLong(dmins);
+  el.style.display = 'block';
+}
+
 function fmtExp(mins) {
   var d = Math.floor(mins / 1440);
   var h = Math.floor((mins % 1440) / 60);
@@ -1677,6 +1707,7 @@ function checkStatus() {
