diff --git a/hotspot/cgi-bin/coin.sh b/hotspot/cgi-bin/coin.sh
index 736a606..88b8053 100755
--- a/hotspot/cgi-bin/coin.sh
+++ b/hotspot/cgi-bin/coin.sh
@@ -19,6 +19,12 @@
 
