-        done
-        BUSY1=$((U1 + N1 + S1 + IR1 + SI1 + ST1))
-        BUSY2=$((U2 + N2 + S2 + IR2 + SI2 + ST2))
-        TOTAL1=$((BUSY1 + I1 + W1))
-        TOTAL2=$((BUSY2 + I2 + W2))
-        DTOTAL=$((TOTAL2 - TOTAL1))
-        DBUSY=$((BUSY2 - BUSY1))
-        [ "$DTOTAL" -gt 0 ] && CPU_PCT=$((DBUSY * 100 / DTOTAL))
