+    [ "$_FW_NEW_CD" -le 525600 ] || err_json "bad_cooldown"
+    if [ "$_FW_NEW_CD" -ne 0 ] && [ "$_FW_NEW_CD" -lt "$_FW_NEW_MIN" ]; then
