+/* ────────────────────────────────────────────────────────────────
+   Free WiFi — one-tap free session (see freewifi.sh / login.sh free=1)
+──────────────────────────────────────────────────────────────── */
+var _freeBusy = false;
+var _freeRecheckID = null;
+
+function fmtFreeLen(mins) {
+  mins = Math.max(1, parseInt(mins, 10) || 0);
+  var h = Math.floor(mins / 60), m = mins % 60;
+  if (h > 0 && m > 0) return h + ' hr ' + m + ' min';
+  if (h > 0)          return h + (h === 1 ? ' hr' : ' hrs');
+  return m + ' min';
+}
+
+function fmtFreeWait(secs) {
+  var d = Math.floor(secs / 86400);
+  var h = Math.floor((secs % 86400) / 3600);
+  var m = Math.ceil((secs % 3600) / 60);
+  if (m === 60) { m = 0; h += 1; }
+  if (d > 0) return d + 'd ' + h + 'h';
+  if (h > 0) return h + 'h ' + m + 'm';
+  return Math.max(1, m) + 'm';
+}
+
+// Shows the Free WiFi button when this device may claim, or a one-line hint
+// while it is waiting out its cooldown. Returns true only when it may claim.
+function updateFreeUI(d) {
+  var btn  = document.getElementById('btn-free-login');
+  var hint = document.getElementById('free-hint');
+  if (!btn || !hint) return false;
+  if (_freeRecheckID) { clearTimeout(_freeRecheckID); _freeRecheckID = null; }
+  btn.style.display  = 'none';
+  hint.style.display = 'none';
+  var mins = parseInt(d.free_minutes, 10);
+  if (!(mins > 0)) return false;               // admin has Free WiFi off
+
+  var wait = parseInt(d.free_wait, 10) || 0;
+  if (wait === 0) {
+    btn.textContent   = 'Free WiFi (' + fmtFreeLen(mins) + ')';
+    btn.style.display = 'block';
+    return true;
+  }
+  if (wait < 0) {
+    hint.textContent = 'Free WiFi has already been used on this device.';
+  } else {
+    hint.textContent = 'Free WiFi is available again in ' + fmtFreeWait(wait) + '.';
+    // Re-check when the wait is over so the button comes back by itself.
+    // Capped: setTimeout overflows past ~24 days.
+    _freeRecheckID = setTimeout(checkStatus, Math.min(wait + 2, 2000000) * 1000);
+  }
+  hint.style.display = 'block';
+  return false;
+}
+
+function doFreeWifi() {
+  if (_freeBusy) return;
+  _freeBusy = true;
+  var btn = document.getElementById('btn-free-login');
+  if (btn) btn.disabled = true;
+
+  fetch('/cgi-bin/login.sh', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body: 'free=1'
+  })
+  .then(function(r) { return r.json(); })
+  .then(function(d) {
+    _freeBusy = false;
+    if (btn) btn.disabled = false;
+    if (d.ok) {
+      show('v-status');
+      // Same captive-portal-compatibility reload as a coin/resume success.
+      if (_reloadAfterTimeAdded) { location.reload(); return; }
+      checkStatus();
+      toastr.success('\u2714\ufe0f Connected! ' + fmtCountdown(d.remaining) + ' of free WiFi.');
+    } else {
+      var msgs = {
+        no_mac:          "Can't detect your device MAC yet \u2014 wait a few seconds and try again.",
+        free_disabled:   'Free WiFi is not available right now.',
+        already_online:  'You are already online.',
+        no_internet:     'No internet connection right now \u2014 Free WiFi is temporarily unavailable.',
+        clock_not_ready: 'The router is still starting up \u2014 please try again in a minute.',
+        try_again:       'Something went wrong \u2014 please try again.',
+        cooldown:        'Too many attempts. Please wait a moment.'
+      };
+      if (d.error === 'free_wait') {
+        toastr.error(d.wait < 0
+          ? 'Free WiFi has already been used on this device.'
+          : 'You can claim Free WiFi again in ' + fmtFreeWait(d.wait) + '.');
+      } else {
+        toastr.error(msgs[d.error] || 'Something went wrong \u2014 please try again.');
+      }
+      // Refresh so the button/hint (or the connected view) matches the server.
