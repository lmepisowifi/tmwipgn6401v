+    [ -n "$_FW_NEW_MIN" ] || _FW_NEW_MIN=0
+    [ -n "$_FW_NEW_CD" ]  || _FW_NEW_CD=0
+    [ "${#_FW_NEW_MIN}" -le 6 ] || err_json "bad_minutes"
+    [ "${#_FW_NEW_CD}" -le 7 ]  || err_json "bad_cooldown"
+
