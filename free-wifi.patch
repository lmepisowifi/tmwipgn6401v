+    fi
+    if [ -n "$_FW_CD" ]; then
+        save_coin_env_var "FREE_WIFI_COOLDOWN" "$_FW_NEW_CD"
+        set_lmehspt_var   "FREE_WIFI_COOLDOWN" "$_FW_NEW_CD"
+        set_globals_var   "FREE_WIFI_COOLDOWN" "$_FW_NEW_CD"
