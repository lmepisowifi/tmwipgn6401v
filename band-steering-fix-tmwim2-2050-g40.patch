diff --git a/www2/cgi-bin/wlanbasic.cgi b/www2/cgi-bin/wlanbasic.cgi
index c1ca2c6..beb80bc 100755
--- a/www2/cgi-bin/wlanbasic.cgi
+++ b/www2/cgi-bin/wlanbasic.cgi
@@ -897,6 +897,26 @@ if [ "$REQUEST_METHOD" = "POST" ]; then
         busybox mv "$MF_TMP" "$MERGE_FILE"
         dbg "save_merge: saved enabled=$M_EN iface24=$M_I24 iface5=$M_I5"
 
+        # Band steering (WIFI_STA_CONTROL) needs the two radios to share one
+        # SSID + security, which is exactly what this merge guarantees. Turning
+        # the merge off lets them diverge, so switch steering off with it —
+        # otherwise it stays enabled in the MIB and keeps steering clients
+        # between two different networks. Any nonzero value counts as on; an
+        # unreadable value is left alone. Done after the NodeMCU ACK check
+        # above so an aborted save leaves nothing half-written.
+        BS_CLEARED=0
+        if [ "$M_EN" != "1" ]; then
+            _bs=$(mib_field "WIFI_STA_CONTROL")
+            case "$_bs" in
+                ''|*[!0-9]*|0) ;;
+                *)
+                    mib set "WIFI_STA_CONTROL" 0
+                    BS_CLEARED=1
+                    dbg "save_merge: cleared WIFI_STA_CONTROL (was $_bs) — merge turned off"
+                    ;;
+            esac
+        fi
+
         if [ "$M_EN" = "1" ]; then
             # Copy 2.4 GHz (master) SSID + security onto the 5 GHz partner
             mib set "WLAN_MBSSIB_TBL.${M_I5}.ssid"    "$S_SSID"
@@ -913,6 +933,19 @@ if [ "$REQUEST_METHOD" = "POST" ]; then
             mib commit
             dbg "save_merge: mirrored 2.4 idx $M_I24 -> 5 idx $M_I5 (ssid=$S_SSID enc=$S_ENC)"
             wlan_apply restart
+        elif [ "$BS_CLEARED" = "1" ]; then
+            # Merge turned off while band steering was on. Switching steering
+            # off in the driver needs both radios re-initialised (stactrl_init
+            # runs on bring-up), so restart WLAN — but in the background after
+            # a short delay, so this reply reaches the browser first. "RESTART"
+            # tells the page to show its apply countdown instead of "Saved".
+            mib commit
+            dbg "save_merge: merge off, band steering was on — restarting WLAN in background"
+            ( sleep 1; wlan_apply restart ) >/dev/null 2>&1 </dev/null &
+            printf "Status: 200 OK\r\n"
+            printf "Content-Type: text/plain\r\n\r\n"
+            printf "RESTART"
+            exit 0
         fi
 
         printf "Status: 200 OK\r\n"
diff --git a/www2/wlanbasic.html b/www2/wlanbasic.html
index 8db8c44..20277b3 100644
--- a/www2/wlanbasic.html
+++ b/www2/wlanbasic.html
@@ -1176,15 +1176,27 @@ function saveMerge() {
     setFormEnabled(false);
 
     if (enabled === 0) {
-        // Turning merge off never restarts the radios — quick save
+        // Turning merge off is a quick save with no radio restart — unless band
+        // steering was on: steering needs the shared network, so it is switched
+        // off together with the merge, which takes a WLAN restart. The CGI
+        // answers "RESTART" (instead of "OK") in that case.
         showOverlay('Saving…');
         fetch(CGI + '?action=save_merge', {
             method: 'POST',
             headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
             body
         })
-        .then(r => { if (!r.ok) return r.text().then(t => { throw new Error(t || ('HTTP ' + r.status)); }); })
-        .then(() => {
+        .then(r => r.text().then(t => {
+            if (!r.ok) throw new Error(t || ('HTTP ' + r.status));
+            return t;
+        }))
+        .then(t => {
+            if (t.trim() === 'RESTART') {
+                // Radios are restarting in the background (reply was sent first)
+                startCountdown('Applying');
+                setTimeout(() => { loadMergeStatus(); pollUntilBack(); }, 4500);
+                return;
+            }
             spinner.style.display = 'none';
             overlayTxt.textContent = 'Saved.';
             setFormEnabled(true);
