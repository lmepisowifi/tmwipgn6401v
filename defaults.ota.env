# ============================================================
# defaults.ota.env — canonical default values for the OTA / module / sound
# download settings
# ============================================================
# This file is SHIPPED and REPLACED by every OTA release (it is a tracked
# component in ota.sh, same as defaults.env). It is the single source of truth
# for the default value of every key that /lmepisowifi/ota.env may set.
#
# Precedence, lowest to highest (each layer only overrides the keys it sets):
#   1. the hard-coded fallback inside each script (ota.sh, module_ctl.sh,
#      hotspot/sound_ctl.sh, hotspot/notify.sh) — only used if this file is
#      missing, e.g. right after the first update that introduces it,
#   2. THIS FILE,
#   3. /lmepisowifi/ota.env — device-local, never shipped, never touched by an
#      update. The admin UI toggles (OTA_AUTO, OTA_INSECURE_TLS,
#      MOD_AUTO_UPDATE) write ONLY there, so an admin's choice always wins.
#
# Unlike defaults.env -> globals.env, keys here are NOT copied into ota.env:
# a device with no entry in ota.env simply follows whatever this file says,
# so changing a default here in a release takes effect on every device that
# has not explicitly overridden it.
#
# Plain KEY="value" lines only: this file is sourced by POSIX sh.
# ============================================================

# ── Update source ─────────────────────────────────────────
# GitHub OWNER/REPO and branch that releases, modules.txt and the sound
# library are fetched from.
OTA_REPO="lmepisowifi/tmwipgn6401v"
OTA_BRANCH="main"
OTA_MANIFEST_URL="https://cdn.jsdelivr.net/gh/lmepisowifi/tmwipgn6401v@main/manifest.txt"
OTA_CHANGELOG_URL="https://cdn.jsdelivr.net/gh/lmepisowifi/tmwipgn6401v@main/CHANGELOG.md"

# ── Behaviour ─────────────────────────────────────────────
# 0 = scheduled check only notifies, 1 = scheduled check also applies.
OTA_AUTO="1"
# 1 = send Telegram/Discord alerts about available/applied updates.
OTA_NOTIFY="1"
# 1 = also push firmware to the coin-slot NodeMCU after a successful apply.
OTA_NODEMCU="1"
# 1 = keep installed modules (hotspot, tailscale) current automatically.
MOD_AUTO_UPDATE="1"

# ── Security ──────────────────────────────────────────────
# 1 = skip HTTPS certificate verification for updates, modules, sounds and
# alerts. Escape hatch for a device with a bad clock / missing CA bundle;
# NOT recommended. Leave at 0 here — set it per device from
# Admin > System > Software Update (writes ota.env).
OTA_INSECURE_TLS="0"
