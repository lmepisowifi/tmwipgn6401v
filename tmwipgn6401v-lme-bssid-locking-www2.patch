+    else
+        _lsup=false
+        _lock="000000000000"
+    fi
 
     _bssid=$(proc_field "$_bssdesc" "bssid")
     [ -z "$_bssid" ] && _bssid="000000000000"
@@ -162,8 +206,8 @@ emit_vxd_status_json() {
