# ============================================================
# defaults.env — canonical default values for tunable globals
# ============================================================
# This file is SHIPPED and REPLACED by every OTA release (it is a
# tracked component in ota.sh). It is the single source of truth for
# default values of user-settable globals.
#
# On boot, lmehspt.sh:
#   1. sources this file (defaults),
#   2. seeds any keys here that are MISSING from globals.env into
#      globals.env (see seed_globals()),
#   3. sources globals.env, whose values override these defaults.
#
# So when an OTA adds a NEW tunable here, existing devices automatically
# gain the key in their (preserved) globals.env with the default value,
# and it shows up pre-filled in the admin UI. Never put runtime-only file
# paths or secrets that shouldn't persist in globals.env here.
# ============================================================

# ── Network / portal ──────────────────────────────────────
PORTAL_IP="10.0.0.1"
PORTAL_PORT="80"
# Hotspot DHCP pool (br1). The range lives inside PORTAL_IP's /24. NodeMCU
# coin acceptors take FIXED IPs from the addresses below DHCP_START
# (gateway+1 .. DHCP_START-1), so DHCP_START also caps how many units can
# exist. DHCP_DNS is a space-separated list pushed to clients.
DHCP_START="5"
DHCP_END="254"
DHCP_DNS="1.1.1.1"
WWW2_PORT="8080"
WAN_INT="br0"
BR0_GATEWAY="192.168.18.1"

# ── Rate limiting ─────────────────────────────────────────
GLOBAL_RATE="50mbit"
PER_USER_RATE="5mbit"
PER_USER_BURST="10k"
UNAUTH_RATE="1000kbit"
INACTIVITY_TIMEOUT="300"
# When "1", each online session's guaranteed rate is GLOBAL_RATE divided by
# however many sessions are currently online instead of the fixed
# PER_USER_RATE above (PER_USER_RATE is ignored while this is on). ceil
# always stays GLOBAL_RATE, so a single active client can still burst to
# the full global rate whenever everyone else is idle. Toggle: www2 >
# Hotspot > Bandwidth & QoS.
EQUAL_SHARING_ENABLED="0"

# ── Feature toggles ───────────────────────────────────────
HOTSPOT_ENABLED="1"
ANTI_TETHER="1"
LAN_ISOLATE="1"
COIN_ENABLED="1"
AUTO_PAUSE_ENABLED="1"
# iOS/Android randomize (or re-randomize on every reconnect) a device's WiFi
# MAC for privacy. Since sessions/firewall rules here are keyed by MAC, a
# customer whose phone hands out a new MAC mid-session looks like a brand
# new device and loses access to time they already paid for. This issues
# each BROWSER a signed, HttpOnly cookie (verified server-side, not just
# trusted as sent) so a returning device is recognized and its
# active/paused session migrated onto the new MAC automatically. See
# /lmepisowifi/hotspot/macfix.sh. Toggle: www2 > Hotspot.
MAC_RANDOMIZATION_FIX="1"
# When the box reboots, any device that was still mid-session (status
# "active" in users.txt) has no way to prove it's still there — the live
# firewall rule and active_sessions.txt entry are both gone (tmpfs, wiped by
# the reboot). Left alone, that stale "active" row would sit there with
# whatever remaining time it last had, doing nothing until the device
# reconnects. On (default): the one-time boot sync converts every such row
# to "paused" instead, preserving its last-known remaining time exactly like
# a manual pause would. Off: leave those rows as "active" untouched. Toggle:
# www2 > Hotspot > Protections.
PAUSE_ON_BOOT="1"

# ── Coin acceptor / NodeMCU ───────────────────────────────
NODEMCU_IP="10.0.0.2"
NODEMCU_MAC="e868e7c81814"
NODEMCU_PORT="8080"
COIN_PSK="lmepisowifi"
# Display title + in-service flag for the primary NodeMCU (#1). Additional
# units (#2+) are managed separately in hotspot_data/nodemcus_extra.txt —
# see lmehspt.sh's NODEMCU_EXTRA_FILE. Existing installs pick these two up
# automatically via seed_globals() without any admin action required.
NODEMCU_1_TITLE="Coin Slot"
NODEMCU_1_ENABLED="1"
COIN_TIMEOUT="30"
COIN_RATES="1:15 5:90 10:210 15:360 20:720 25:1080 30:2160 35:2880 40:3600 45:4320 50:5040 55:5760"
# Anti-griefing strike system for empty coin sessions. On by default (the
# system's original always-on behavior); set to "0" to keep the coin
# acceptor itself on while disabling just this suspension check.
COIN_STRIKE_ENABLED="1"
COIN_STRIKE_THRESHOLD="3"
COIN_COOLDOWN="60"
# When "1" (default), a client who hits Insert Coin while someone else is
# already using the slot gets placed in line and notified when it's their
# turn. When "0", they are turned away immediately instead, with error
# "Coin slot is in use, try again later." — no waiting list is kept.
COIN_QUEUE_ENABLED="1"
# How long (seconds) the portal keeps a coin session alive while the NodeMCU
# is unreachable mid-insert before finally giving up. During this window the
# poll reports "reconnecting" (coins preserved, countdown frozen) instead of
# expiring. Keep this equal to the firmware's MAX_PAUSE_MS (5 min = 300s) so
# both sides abandon a truly dead link at roughly the same time.
COIN_RECONNECT_GRACE="300"
# When "1", the "start" action refuses to open a new coin session while the
# router has no internet connectivity (checked every ~15s by the watchdog —
# see /tmp/internet_up). Sessions already in progress are never cut off by
# this, only new coin insertions.
COIN_REQUIRE_INTERNET="0"
# Same idea for voucher redemption in login.sh — when "1", a voucher code
# submitted while there is no internet connectivity is rejected (error
# "no_internet") instead of being burned.
VOUCHER_REQUIRE_INTERNET="0"
# Wrong-voucher anti-troll strike system, same shape as COIN_STRIKE_THRESHOLD
# / COIN_COOLDOWN above but keyed on repeated incorrect voucher submissions.
# When VOUCHER_STRIKE_ENABLED="1", login.sh temporarily suspends further
# voucher attempts from a device after VOUCHER_STRIKE_THRESHOLD wrong codes
# in a row, for VOUCHER_COOLDOWN seconds. Off by default (opt-in).
VOUCHER_STRIKE_ENABLED="0"
VOUCHER_STRIKE_THRESHOLD="3"
VOUCHER_COOLDOWN="60"
# Master switch for voucher code redemption, same shape as COIN_ENABLED.
# When "0", login.sh refuses all new voucher-code submissions. On by
# default so existing installs keep today's always-available behavior.
VOUCHER_ENABLED="1"

# ── Time sync ─────────────────────────────────────────────
NTP_SERVERS="pool.ntp.org time.google.com time.cloudflare.com"
