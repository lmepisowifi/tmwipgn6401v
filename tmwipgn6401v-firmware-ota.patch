@@ -113,6 +117,14 @@ OTA_NODEMCU="1"                    # 1 = also push firmware to the coin-slot Nod
 # manifest AND a matching tarball and get root code execution via OTA.
 [ -f "$OTA_CACERT" ] || OTA_CACERT="$ROOT/www2/sh/cacert.pem"
 
+# ---- firmware OTA (see "Firmware OTA" below) --------------------------------
+FW_MODEL="PGN6401V"                      # per repo: firmware.txt's fw_model must equal this, or nothing is flashed
+FWBOOT="$ROOT/www2/sh/fwboot.sh"         # owns every flash-safety rule
