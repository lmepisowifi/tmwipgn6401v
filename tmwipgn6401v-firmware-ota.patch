 set_status() { printf '%s' "$1" > "$STATUS_FILE"; }
@@ -1240,6 +1252,10 @@ do_cron() {
     # this very script — see self_heal() for the full explanation.
     self_heal
 
+    # Firmware (A/B slot) updates are NEVER applied from cron: this only tells
+    # the admin one is waiting. Never fails, never blocks the checks below.
+    fw_cron_notice
+
     _json=$(do_check)
 
     if echo "$_json" | grep -q '"update_available":true'; then
@@ -1495,6 +1511,281 @@ sync_nodemcu() {
     return $_fail
 }
 
+# ===========================================================================
+# Firmware OTA — Realtek Luna firmware tar(.gz) -> the OTHER A/B flash slot
+# ===========================================================================
+# The file-sync OTA above only swaps app files under /lmepisowifi. This is the
+# other half: it fetches a vendor-format firmware tar (uImage + rootfs + md5.txt
+# + fwu.sh + fwu_ver, optionally gzipped) and writes it into the inactive flash
+# slot through www2/sh/fwboot.sh, which owns every flash-safety rule: never the
+# running or default slot, md5 + size checks, read-back after writing, and the
+# slot's version is recorded only once it is complete.
+#
+# Safety model of this layer:
+#   * Never automatic. Cron only notifies (fw_cron_notice); a person starts it.
+#   * firmware.txt must name this device's model (FW_MODEL), carry a sha256, and
+#     point at this repo's Releases (or its jsDelivr tree) - same pin as above.
+#   * fw_apply MODE: stage = write the slot, change nothing else;
+#     next = write the slot and arm a trial boot that is kept if it comes up
+#     cleanly (same as keep), but do NOT reboot: the next restart for any reason
+#     (power cut, crash, manual reboot) tries the new slot, fw_loaded.sh makes it
+#     the default if it starts cleanly, and U-Boot's watchdog falls back to the
+#     current slot if it does not;
+#     default = write the slot and make it the default boot slot, but do NOT
+#     reboot: the device switches over the next time it restarts for any reason.
+#     No trial boot, so no automatic fall-back;
+#     once = also boot it a single time (the next reboot returns to the old
+#     slot, U-Boot's watchdog falls back if it hangs); keep = trial boot that
+#     becomes the default if it comes up cleanly (fw_loaded.sh commits it).
+#     Only once and keep reboot the device (they start the reboot themselves);
+#     stage, next and default never do.
+#   * /lmepisowifi is its own UBIFS volume, so settings/vouchers/income are not
+#     part of either slot and carry across.
+#
+# firmware.txt (next to manifest.txt, written by fwpublish.sh):
+#   fw_version=lmepisowifi_V8.1.2   must equal the tar's fwu_ver (cleaned)
+#   fw_model=PGN6401V
+#   fw_url=https://github.com/OWNER/REPO/releases/download/TAG/NAME.tar.gz
+#   fw_sha256=<64 hex of the file at fw_url>
+#   fw_size=<bytes of that file>            (optional, sizes the RAM check)
+#   fw_notes=<one line>                     (optional)
+#   fw_url_mirror=<jsDelivr url>            (optional, tried first)
+
+fw_manifest_url() {
+    if [ -n "$OTA_MANIFEST_URL" ]; then
+        echo "$OTA_MANIFEST_URL" | sed 's#/manifest\.txt#/firmware.txt#'
+    else
+        echo "https://cdn.jsdelivr.net/gh/${OTA_REPO}@${OTA_BRANCH}/firmware.txt"
+    fi
+}
+fwval() { sed -n "s/^$1=//p" "$DL/firmware.txt" | tr -d '\r' | head -1; }
+fw_set() { printf '%s' "$1" > "$FW_STATUS_FILE"; printf '%s' "$2" > "$FW_MSG_FILE"; log "[$1] $2"; }
+fw_fail() { fw_set failed "$1"; return 1; }
+
+# `fwboot.sh info` -> key=value lines (supported, running, ver0/ver1, target, why...).
+fw_load_info() { _FW_INFO=""; [ -f "$FWBOOT" ] && _FW_INFO=$(sh "$FWBOOT" info 2>/dev/null); return 0; }
+fw_info() { printf '%s\n' "$_FW_INFO" | sed -n "s/^$1=//p" | head -n 1; }
+
+# The slot the NEXT restart will switch to: a pending trial boot, else a default
+# slot that is not the one running. Empty when the device will come back on the
+# slot it runs now. (fw_load_info must have run.)
+fw_pending_slot() {
+    _pa=$(fw_info active); _pc=$(fw_info commit); _pt=$(fw_info tryactive)
+    case "$_pa" in 0|1) ;; *) return 0 ;; esac
+    case "$_pt" in 0|1) [ "$_pt" != "$_pa" ] && { echo "$_pt"; return 0; } ;; esac
+    case "$_pc" in 0|1) [ "$_pc" != "$_pa" ] && echo "$_pc" ;; esac
+    return 0
+}
+
+# Fetch + validate firmware.txt. Sets FW_VER FW_URL FW_SUM FW_SIZE FW_NOTES FW_MURL;
+# on failure sets FW_ERR and returns 1.
+fw_load_manifest() {
+    FW_ERR=""; mkdir -p "$DL"
+    fetch "$(fw_manifest_url)" "$DL/firmware.txt"; _fwrc=$?
+    if [ "$_fwrc" -ne 0 ]; then
+        case "$_fwrc" in
+            5) FW_ERR="HTTPS certificate check failed - the device clock is probably wrong. Fix the time, or turn on Skip certificate check" ;;
+            8) FW_ERR="no firmware has been published for this device yet" ;;
+            *) FW_ERR="could not reach update server (jsDelivr/GitHub)" ;;
+        esac
+        return 1
+    fi
+    if grep -Eqi 'rate.limit|Too Many Requests|terms.*service' "$DL/firmware.txt" 2>/dev/null; then
+        FW_ERR="update server rate limited - wait a few minutes and try again"; return 1
+    fi
+    # Same character set fwboot.sh records for a slot, so the comparison is exact.
+    FW_VER=$(fwval fw_version | tr -cd 'A-Za-z0-9._+:/ ()-' | cut -c1-64)
+    FW_URL=$(fwval fw_url);   FW_SUM=$(fwval fw_sha256); FW_SIZE=$(fwval fw_size)
+    FW_NOTES=$(fwval fw_notes); FW_MURL=$(fwval fw_url_mirror); FW_MDL=$(fwval fw_model)
+    if [ -z "$FW_VER" ] || [ -z "$FW_URL" ] || [ -z "$FW_SUM" ] || [ -z "$FW_MDL" ]; then
+        FW_ERR="firmware manifest incomplete (need fw_version, fw_model, fw_url, fw_sha256)"; return 1
+    fi
+    if [ "$FW_MDL" != "$FW_MODEL" ]; then
+        FW_ERR="firmware manifest is for \"$FW_MDL\", this device is \"$FW_MODEL\" - refusing"; return 1
+    fi
+    case "$FW_SUM" in *[!0-9a-f]*) FW_ERR="firmware manifest has a malformed sha256"; return 1 ;; esac
+    [ "${#FW_SUM}" -eq 64 ] || { FW_ERR="firmware manifest has a malformed sha256"; return 1; }
+    _url_ok "$FW_URL" || { FW_ERR="refusing firmware url outside this repo (Releases or jsDelivr)"; return 1; }
+    case "$FW_SIZE" in ""|*[!0-9]*) FW_SIZE=0 ;; esac
+    [ "$FW_SIZE" -le 67108864 ] || { FW_ERR="firmware is larger than the 64 MiB limit"; return 1; }
+    return 0
+}
+
+# Prints JSON, always returns 0 (errors are inside the JSON, like do_check).
+do_fw_check() {
+    fw_load_info; _run=$(fw_info running)
+    if [ "$(fw_info supported)" != "1" ]; then
+        printf '{"error":"this device does not expose a dual-image (A/B) firmware layout","running":"%s"}\n' "$(json_esc "$_run")"
+        return 0
+    fi
+    if ! fw_load_manifest; then
+        printf '{"error":"%s","running":"%s"}\n' "$(json_esc "$FW_ERR")" "$(json_esc "$_run")"
+        return 0
+    fi
+    _tgt=$(fw_info target); _why=$(fw_info why); _tver=""
+    [ -n "$_tgt" ] && _tver=$(fw_info "ver$_tgt")
+    _upd=false; _staged=false; _pend=false; _pslot=$(fw_pending_slot)
+    if [ "$FW_VER" != "$_run" ]; then
+        if [ -n "$_pslot" ] && [ "$(fw_info "ver$_pslot")" = "$FW_VER" ]; then
+            # pending = already written AND the next restart will boot it; nothing left to do
+            _pend=true
+        elif [ -n "$_tgt" ] && [ "$_tver" = "$FW_VER" ]; then
+            # staged = the slot a flash would use already holds exactly this version
+            _staged=true
+        else
+            _upd=true
+        fi
+    fi
