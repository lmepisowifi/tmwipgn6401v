+# ---- gzip support -----------------------------------------------------------
+# Detect by magic bytes (1f 8b), never by file name. Needs only printf, head and
+# md5sum: the md5 of the two magic bytes is computed once rather than using od.
+GZ_MAGIC=$(printf '\037\213' | md5sum | awk '{print $1}')
+is_gz() { [ "$(head -c 2 "$1" 2>/dev/null | md5sum | awk '{print $1}')" = "$GZ_MAGIC" ]; }
+
+# Replace a gzip file with its contents, so the many tar passes below read a
+# plain tar instead of re-inflating the archive every time. Peak RAM use is the
+# .gz plus the unpacked tar. Output is capped at MAX_DL_BYTES, which also bounds a
+# gzip bomb. Sets CK_ERR and returns 1 on failure; the original file is untouched.
+gunzip_inplace() {   # $1=file
+    _gz="$1"; _gzo="$1.unz"
+    _gzsz=$(wc -c < "$_gz" 2>/dev/null | tr -d ' ')
+    _gzavail=$(df -k "$(dirname "$_gz")" 2>/dev/null | tail -n 1 | awk '{print $(NF-2)}')
+    case "$_gzavail" in ""|*[!0-9]*|0) ;; *)
+        _gzneed=$(( _gzsz / 1024 * 2 + 2048 ))
+        [ "$_gzavail" -ge "$_gzneed" ] \
+            || { CK_ERR="not enough free memory to unpack the .tar.gz: need ${_gzneed} KB, have ${_gzavail} KB"; return 1; } ;;
+    esac
+    gzip -dc "$_gz" 2>/dev/null | head -c $((MAX_DL_BYTES + 1)) > "$_gzo"
+    _unz=$(wc -c < "$_gzo" 2>/dev/null | tr -d ' ')
+    case "$_unz" in ""|0) rm -f "$_gzo"; CK_ERR="could not unpack the gzip file (corrupt, or not really gzip)"; return 1 ;; esac
+    if [ "$_unz" -gt "$MAX_DL_BYTES" ]; then
+        rm -f "$_gzo"; CK_ERR="unpacked firmware is larger than $((MAX_DL_BYTES / 1048576)) MiB"; return 1
+    fi
+    mv "$_gzo" "$_gz" || { rm -f "$_gzo"; CK_ERR="could not replace the gzip file with its contents"; return 1; }
+    logm "unpacked gzip firmware: $_gzsz -> $_unz bytes"
+}
