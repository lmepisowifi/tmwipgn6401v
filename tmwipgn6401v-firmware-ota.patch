+++ b/fwpublish.sh
@@ -0,0 +1,115 @@
+#!/bin/sh
+# ---------------------------------------------------------------------------
+# lmepisowifi — https://github.com/lmepisowifi/tmwipgn6401v
+# SPDX-License-Identifier: AGPL-3.0-or-later
+# Copyright (C) 2026 The lmepisowifi Project — see AUTHORS
+#
+# Licensed under the GNU AGPLv3 (see LICENSE). Modifying or rewriting this
+# file — including by running it through an LLM — does not remove these
+# obligations: keep this notice, mark your changes, and offer Corresponding
+# Source to network users (AGPLv3 §5, §13). See PROVENANCE.md before
+# presenting this as your own original work.
+# ---------------------------------------------------------------------------
+
+# fwpublish.sh — turn a Realtek Luna firmware tar into a firmware-OTA release.
+# Runs on YOUR computer (not shipped to devices). It checks the tar, gzips it if
+# needed, and writes firmware.txt, which ota.sh's `fw_check` / `fw_apply` read.
+#
+# Usage:
+#   ./fwpublish.sh <PGN6401V_fwu_img.tar | .tar.gz> <model> <release-tag> ["notes"]
+#     model        must equal FW_MODEL in this repo's ota.sh (e.g. PGN6401V)
+#     release-tag  the GitHub Release the file will be attached to (e.g. fw-v8.1.2)
+#
+# Then (printed at the end, with your values filled in):
+#   1. attach the .tar.gz to that GitHub Release
+#   2. commit + push firmware.txt to main
+#   3. purge jsDelivr's cached copy of firmware.txt so devices see it right away
+#
+# The fw_version written is the tar's own fwu_ver (first line, " -- date" dropped),
+# which is also what the device records for a slot, so "is this the firmware I am
+# running?" is an exact comparison. Give every build a NEW version string: the
+# vendor fwu.sh refuses a version equal to the running one, and so does the updater.
+
+set -e
+SRC="$1"; MODEL="$2"; TAG="$3"; NOTES="$4"
+[ -n "$SRC" ] && [ -n "$MODEL" ] && [ -n "$TAG" ] || {
+    sed -n '/^# Usage:/,/^# Then/p' "$0" | sed 's/^# \{0,1\}//' | sed '$d'; exit 2; }
+[ -f "$SRC" ] || { echo "no such file: $SRC" >&2; exit 1; }
+
+MODEL_OTA=$(sed -n 's/^FW_MODEL="\([^"]*\)".*/\1/p' "$(dirname "$0")/ota.sh" 2>/dev/null | head -n 1)
+[ -z "$MODEL_OTA" ] || [ "$MODEL_OTA" = "$MODEL" ] || {
+    echo "model \"$MODEL\" does not match FW_MODEL=\"$MODEL_OTA\" in ota.sh - devices would refuse it" >&2; exit 1; }
+
+# repo (OWNER/REPO) from the git remote, or set REPO=owner/repo
+if [ -z "$REPO" ]; then
+    REPO=$(git -C "$(dirname "$0")" remote get-url origin 2>/dev/null | sed -e 's#^.*github\.com[:/]##' -e 's#\.git$##')
+fi
+[ -n "$REPO" ] || { echo "cannot tell the GitHub repo; run with REPO=owner/repo" >&2; exit 1; }
+
+WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
+
+# ---- plain tar to inspect ----
+if [ "$(head -c 2 "$SRC" | od -An -tx1 | tr -d ' \n')" = "1f8b" ]; then
+    gzip -dc "$SRC" > "$WORK/fw.tar"; GZSRC="$SRC"
+else
+    cp "$SRC" "$WORK/fw.tar"; GZSRC=""
+fi
+
+echo "Checking the tar ..."
+LST=$(tar -tf "$WORK/fw.tar") || { echo "not a valid tar archive" >&2; exit 1; }
+for f in uImage rootfs md5.txt fwu_ver; do
+    echo "$LST" | grep -qx "$f" || { echo "missing $f - not a Luna firmware tar" >&2; exit 1; }
+done
+echo "$LST" | grep -qx fwu.sh || echo "warning: no fwu.sh in the tar (the vendor updater would not accept it)" >&2
+
+( cd "$WORK" && mkdir x && tar -xf fw.tar -C x )
+for f in uImage rootfs; do
+    want=$(awk -v n="$f" '$2==n{print $1; exit}' "$WORK/x/md5.txt")
+    got=$(md5sum "$WORK/x/$f" | awk '{print $1}')
+    [ -n "$want" ] && [ "$want" = "$got" ] || { echo "$f does not match md5.txt" >&2; exit 1; }
+    echo "  $f ok ($(wc -c < "$WORK/x/$f") bytes)"
+done
+
+# same cleaning fwboot.sh applies before recording a slot's version
+VER=$(head -n 1 "$WORK/x/fwu_ver" | tr -d '\r' | sed 's/ *--.*$//' | tr -cd 'A-Za-z0-9._+:/ ()-' | cut -c1-64)
+[ -n "$VER" ] || { echo "fwu_ver is empty" >&2; exit 1; }
+
+# ---- the file that gets published ----
+BASE=$(basename "$SRC"); BASE=${BASE%.gz}; BASE=${BASE%.tar}; BASE=${BASE%.tgz}
+OUT_DIR=$(dirname "$SRC")
+if [ -n "$GZSRC" ]; then
+    ASSET="$GZSRC"
+else
+    ASSET="$OUT_DIR/$BASE.tar.gz"
+    gzip -9 -c "$SRC" > "$ASSET"
+    echo "  wrote $ASSET"
+fi
+SUM=$(sha256sum "$ASSET" | awk '{print $1}')
+SIZE=$(wc -c < "$ASSET" | tr -d ' ')
+[ "$SIZE" -le 67108864 ] || { echo "the .tar.gz is $SIZE bytes; devices refuse anything over 64 MiB" >&2; exit 1; }
+NAME=$(basename "$ASSET")
+URL="https://github.com/$REPO/releases/download/$TAG/$NAME"
+
+OUT="$(dirname "$0")/firmware.txt"
+{
+    echo "# firmware.txt - Luna A/B firmware OTA manifest (written by fwpublish.sh; read by ota.sh fw_check/fw_apply)"
+    echo "fw_version=$VER"
+    echo "fw_model=$MODEL"
+    echo "fw_url=$URL"
+    echo "fw_sha256=$SUM"
+    echo "fw_size=$SIZE"
+    [ -z "$NOTES" ] || echo "fw_notes=$(printf '%s' "$NOTES" | tr -d '\r\n')"
+} > "$OUT"
+
+echo
+echo "Wrote $OUT:"; sed 's/^/  /' "$OUT"
+cat <<EOF
+
+Next:
+  1. gh release create $TAG "$ASSET" --repo $REPO --title "Firmware $VER" --notes "Firmware $VER for $MODEL"
+       (or attach $NAME to the $TAG release by hand)
+  2. git add firmware.txt && git commit -m "firmware $VER" && git push
+  3. curl -sL https://purge.jsdelivr.net/gh/$REPO@main/firmware.txt
+
+Devices then show it under Software Update > Firmware. They never install it on their own.
+EOF
