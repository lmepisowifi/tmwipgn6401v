diff --git a/www2/httpd.conf b/www2/httpd.conf
index d023b86..f7f5609 100644
--- a/www2/httpd.conf
+++ b/www2/httpd.conf
@@ -18,3 +18,8 @@
 # load until you reload the page."
 .woff:font/woff
 .woff2:font/woff2
+
+# Always revalidate (ETag/Last-Modified -> cheap 304) instead of letting the
+# browser heuristically cache login.html / nav.js / css across OTA updates.
+# Needs the patched httpd.c; an unpatched busybox just logs a config error.
+CacheControl:no-cache
