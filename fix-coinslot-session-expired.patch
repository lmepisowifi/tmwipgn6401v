@@ -904,8 +995,20 @@ cancel)
     CANCEL_RESP=$(wget -q -T 5 -O - \
         "http://${_N_IP}:${_N_PORT}/cancel?sid=${SID}&sig=${CANCEL_SIG}" \
         2>/dev/null)
-    [ -z "$CANCEL_RESP" ] && \
-        _coin_alert "CANCEL_NO_RESPONSE" "SID=${SID} NodeMCU (node ${SESSION_NODE}) did not respond to /cancel — may be offline or mid-reboot"
+    if [ -z "$CANCEL_RESP" ]; then
+        # A blank response only means THIS particular HTTP round trip
+        # didn't come back within the timeout — it does NOT mean the
+        # cancel failed. NodeMCU finalizes and posts to coin_result.sh
+        # asynchronously (see the normal end-of-session path's comments),
