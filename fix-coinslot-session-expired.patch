+                    if [ "$GRANTWAIT" -lt 4 ]; then
+                        FROZEN_REM=$(cat "$REM_PATH" 2>/dev/null); FROZEN_REM=${FROZEN_REM:-$REMAINING}
+                        _ok "{\"status\":\"reconnecting\",\"amount\":${_RESCUE_TOTAL},\"minutes\":${_RESCUE_MIN},\"remaining\":${FROZEN_REM}}"
+                    fi
+                fi
+
+                # Either nothing crosses a tier, or coin_result.sh's own
+                # POST never showed up within the grace window above — bank
+                # whatever we last verified (same rescue the resume-check's
+                # offline path uses) and stamp the same .result
+                # duplicate-guard, so a late-arriving real grant for this
+                # exact sid (a normal end POST that got delayed further
+                # still, or a flash-crash recovery replay) becomes a no-op
+                # instead of a double credit.
                 if [ "$LIVE_AMOUNT" -gt 0 ]; then
                     _lock
                     _bank_add "$SESSION_MAC" "$LIVE_AMOUNT"
-                    printf '%s 0\n' "$LIVE_AMOUNT" > "$RESULT_PATH"
                     _unlock
                     # Same income/notification gap as the resume-check
                     # rescue above: this bypasses coin_result.sh, so record
@@ -770,9 +855,15 @@ poll)
                     _L_MSG=$(tpl_render "$TPL_COINS_INSERTED" insertcoinamt "$LIVE_AMOUNT" mac "$SESSION_MAC")
                     ( /lmepisowifi/hotspot/notify.sh "$_L_MSG" "" coins_inserted >/dev/null 2>&1 </dev/null & )
                 fi
-                rm -f "$SESSION_PATH" "$MISS_PATH" "$AMT_PATH" "$REM_PATH" "/tmp/coin_lock_${SESSION_NODE}"
+                # Nothing was actually consumed into time by this file, so
