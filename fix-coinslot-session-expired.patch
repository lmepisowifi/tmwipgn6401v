+# Same greedy evaluation as _calc_time, but also prints the leftover pesos
+# after tiers as a second field (mirroring coin_result.sh's own inline
+# calculator), for symmetry — the poll handler's LIVE_ACTIVE:false rescue
+# below is the only current caller, and only reads the minutes field, to
+# preview whether folding a newly-rescued amount against whatever's already
+# in COIN_BANK_FILE would cross a tier — exactly like coin_result.sh's own
+# fold-through logic — so it knows whether to hold off and give
+# coin_result.sh's real grant a chance to land, instead of deciding purely
+# off the live amount while blind to the existing bank balance. coin.sh
+# never actually consumes a tier itself, so whatever's rescued always gets
+# banked in full via _bank_add regardless of what this previews.
+_calc_fold() {
+    printf '%s %s\n' "$COIN_RATES" "$1" | awk '
+    {
+        amt=$NF; n=NF-1
+        for(i=1;i<=n;i++){split($i,a,":");pesos[i]=a[1]+0;mins[i]=a[2]+0}
+        for(i=1;i<n;i++) for(j=i+1;j<=n;j++)
+            if(pesos[j]>pesos[i]){
+                tp=pesos[i];pesos[i]=pesos[j];pesos[j]=tp
+                tm=mins[i]; mins[i]=mins[j]; mins[j]=tm
+            }
+        rem=amt+0; total=0
+        for(i=1;i<=n;i++) if(pesos[i]>0){
+            c=int(rem/pesos[i]); total+=c*mins[i]; rem-=c*pesos[i]
+        }
+        print total, rem
+    }'
+}
