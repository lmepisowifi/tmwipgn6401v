diff --git a/hotspot/cgi-bin/coin_result.sh b/hotspot/cgi-bin/coin_result.sh
index 01f2bfc..acc6f8c 100755
--- a/hotspot/cgi-bin/coin_result.sh
+++ b/hotspot/cgi-bin/coin_result.sh
@@ -289,14 +289,25 @@ else
     EXP_SIG=$(_md5 "${N_PSK}:${SID}:${AMOUNT}:end")
     [ "$SIG" = "$EXP_SIG" ] || _err "Bad sig"
 
-    [ -f "$SESSION_PATH" ] || _err "Session not found"
-
+    # Check for an already-posted result BEFORE requiring SESSION_PATH to
+    # still exist. coin.sh's poll-driven rescues (the LIVE_ACTIVE:false
+    # branch and the give-up-after-RECONNECT_GRACE branch) can win the race
+    # against this normal end-of-session POST: NodeMCU answers /status
+    # "active:false" as soon as it finalizes locally, before it gets around
+    # to actually sending US this POST ("a moment later" per those rescues'
+    # own comments) — so by the time we're called, a rescue may have
+    # already banked the coins, written RESULT_PATH, AND deleted
+    # SESSION_PATH. Requiring SESSION_PATH first would turn every one of
+    # those races into a silently-dropped "Session not found" instead of
+    # the graceful duplicate no-op this is meant to be.
     if [ -f "$RESULT_PATH" ]; then
         PREV_MIN=$(awk '{print $2}' "$RESULT_PATH")
         _clear_pending "$SID"
         _ok "{\"ok\":true,\"minutes\":${PREV_MIN},\"duplicate\":true}"
     fi
 
+    [ -f "$SESSION_PATH" ] || _err "Session not found"
+
     # --- Guard 4: Reject stale replays ---
     LAST_SEEN=$(awk '{print ($3==""?$2:$3)}' "$SESSION_PATH")
     SESSION_AGE=$(( NOW - LAST_SEEN ))
