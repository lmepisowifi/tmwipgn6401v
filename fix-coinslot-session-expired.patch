+                rm -f "$SESSION_PATH" "$MISS_PATH" "$AMT_PATH" "$REM_PATH" "$GRANTWAIT_PATH" "/tmp/coin_lock_${SESSION_NODE}"
                 _clear_pending "$SID"
-                _ok "{\"status\":\"expired\",\"amount\":${LIVE_AMOUNT},\"minutes\":$(_calc_time "$LIVE_AMOUNT")}"
+                _ok "{\"status\":\"expired\",\"amount\":${_RESCUE_TOTAL},\"minutes\":0}"
