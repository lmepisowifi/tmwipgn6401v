-        _ok "{\"status\":\"expired\",\"amount\":${GIVEUP_AMT},\"minutes\":$(_calc_time "$GIVEUP_AMT")}"
+        _ok "{\"status\":\"expired\",\"amount\":${GIVEUP_TOTAL},\"minutes\":0}"
     fi
 
     # Query NodeMCU for live coin count — verify its response signature
@@ -749,19 +802,51 @@ poll)
             if [ "$LIVE_ACTIVE" -eq 0 ]; then
                 # NodeMCU has AUTHORITATIVELY confirmed this sid is no
                 # longer live there — a normal timeout/Done/Cancel already
-                # finalized it, or it rebooted. Bank whatever we last
-                # verified for it (same rescue the resume-check's offline
-                # path uses) and stamp the same .result duplicate-guard, so
-                # a late-arriving real grant for this exact sid (a normal
-                # end POST that got delayed, or a flash-crash recovery
-                # replay) becomes a no-op instead of a double credit.
-                # Resolves in one round trip instead of waiting out 4
-                # misses and then the full RECONNECT_GRACE window to reach
-                # the same conclusion the slow way.
+                # finalized it, or it rebooted.
+                #
+                # LIVE_AMOUNT alone is only this session's own coins — fold
+                # in whatever's already banked (BANKED, resolved up top) to
+                # see whether the COMBINED total actually crosses a rate
+                # tier, the same way coin_result.sh's own fold-through logic
+                # would (and the same way the active/reconnecting responses
+                # below already fold BANKED into TOTAL_AMOUNT).
+                _RESCUE_TOTAL=$(( BANKED + LIVE_AMOUNT ))
+                _RF=$(_calc_fold "$_RESCUE_TOTAL")
+                _RESCUE_MIN=${_RF%% *}
+                GRANTWAIT_PATH="${SESSION_PATH}.grantwait"
+
+                if [ "${_RESCUE_MIN:-0}" -gt 0 ]; then
+                    # Real time is owed here. This file never grants it
+                    # itself — no SESSION_FILE/USERS_FILE of its own to
+                    # touch (see mf_reconcile's comment up top) — only
+                    # coin_result.sh's normal end-of-session POST can
+                    # actually extend the session, and NodeMCU sends that
+                    # "a moment later" per its own comments elsewhere in
+                    # this file. Deleting SESSION_PATH right now would
+                    # strand that POST with nothing left to attach the
+                    # grant to (Session not found), turning a real grant
+                    # into a silently-dropped one. Give it a short, bounded
+                    # window — a few more ~1s polls, not a blocking sleep —
+                    # before falling back to the old "just bank it" rescue.
+                    GRANTWAIT=$(cat "$GRANTWAIT_PATH" 2>/dev/null); GRANTWAIT=$(( ${GRANTWAIT:-0} + 1 ))
