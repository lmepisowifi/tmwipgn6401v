<h3>Portal Server</h3>
<div class="row">
  <div><label>Portal IP</label>
       <input id="ip" type="text" value="10.0.0.1"></div>
  <div><label>Portal Port</label>
       <input id="port" type="number" value="80"></div>
</div>

<h3>Performance</h3>
<label>CPU Frequency</label>
<select id="cpufreq">
  <option value="80" selected>80 MHz (stock — most stable)</option>
  <option value="160">160 MHz (faster — more heat/power draw)</option>
</select>

<button id="saveBtn" onclick="save()">Save &amp; Connect</button>
<div id="msg"></div>
</div>

<script>
function scan() {
  var nb = document.getElementById('scanBtn');
  var nl = document.getElementById('netList');
  nb.disabled = true; nb.textContent = 'Scanning...';
  nl.innerHTML = '';
  fetch('/scan').then(function(r){return r.json();}).then(function(nets){
    nb.disabled = false; nb.textContent = 'Scan for Networks';
    if (!nets.length) { nl.innerHTML='<div style="color:#666;padding:8px;font-size:13px">No networks found — try again</div>'; return; }
    nl.innerHTML = nets.map(function(n){
      return '<div class="net" onclick="pick(\''+n.ssid.replace(/\\/g,'\\\\').replace(/'/g,"\\'")+ '\','+n.enc+')">'
        +'<span style="font-size:14px">'+n.ssid+'</span>'
        +'<span class="net-right">'+(n.enc?'<span class="lock"></span>':'')+n.rssi+'dBm</span>'
        +'</div>';
    }).join('');
  }).catch(function(){
    nb.disabled=false; nb.textContent='Scan for Networks';
    nl.innerHTML='<div style="color:#f88;padding:8px;font-size:13px">Scan failed — try again</div>';
  });
}
function pick(ssid, enc) {
  document.getElementById('ssid').value = ssid;
  document.getElementById('pass').value = '';
  document.getElementById('pass').focus();
}
function save() {
  var ssid=document.getElementById('ssid').value.trim();
  var psk =document.getElementById('psk').value.trim();
  if (!ssid) { showMsg('SSID is required.','err'); return; }
  if (!psk)  { showMsg('PSK is required — it must match COIN_PSK in lmehspt.sh.','err'); return; }
  var btn = document.getElementById('saveBtn');
  btn.disabled=true; btn.textContent='Saving...';
  var data = new URLSearchParams({
    ssid: ssid,
    pass: document.getElementById('pass').value,
    psk:  psk,
    ip:   document.getElementById('ip').value.trim(),
    port: document.getElementById('port').value,
    coinval: document.getElementById('coinval').value,
    timeout: document.getElementById('timeout').value,
    cpufreq: document.getElementById('cpufreq').value
  });
  fetch('/save', {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:data.toString()})
  .then(function(r){return r.json();})
  .then(function(j){
    if (j.ok) {
      showMsg('Saved! NodeMCU is rebooting and connecting to "'+ssid+'".\n\nIt will disappear from this AP. If it fails to connect it will come back as PisoWifi-Setup.','ok');
    } else {
      btn.disabled=false; btn.textContent='Save & Connect';
      showMsg('Error: '+(j.error||'Unknown'),'err');
    }
  })
  .catch(function(){
    // Connection dropped on reboot — expected, treat as success
    showMsg('Config saved. NodeMCU is rebooting — this AP will disappear shortly.','ok');
  });
}
function showMsg(t,cls) {
  var m=document.getElementById('msg');
  m.textContent=t; m.className=cls; m.style.display='block';
}
