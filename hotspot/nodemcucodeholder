// UTILITIES
// ══════════════════════════════════════════════════════════════════════

// ── SIGNING — fixed buffers, zero heap traffic ─────────────────────────
// The old md5_hex()/sig_ok() took Strings and every call site built the
// "psk:sid:action" plaintext with chained String concatenation
// (String(cfg.psk) + ":" + sid + ":start", etc). Each "+" allocates a new
// throwaway String and frees the previous one. /status alone is polled
// about once a second for the whole length of a session, so that one path
// was doing 8-10 short-lived heap alloc/free cycles per second — exactly
// the churn that chops the heap into the small blocks the watchdog above is
// working around. These versions build the plaintext into a stack buffer
// with snprintf and ask MD5Builder to write hex digits into another stack
// buffer, so a signature check now allocates nothing at all.
//
// SIG_PLAIN_LEN covers the longest plaintext we ever sign: PSK(127) +
// nonce(16) + ssid(63) + pass(63) + separators/literal ("setwifi" etc) —
// rounded well up for headroom.
#define SIG_PLAIN_LEN 320

void md5_hex_buf(const char* plain, char out[33]) {
    // Guard against a silent OOM: if the heap can't fit MD5Builder's working
    // buffer the resulting hash is meaningless. Log it so a 403 caused by
    // allocation failure is distinguishable from a real PSK mismatch.
    if (ESP.getMaxFreeBlockSize() < 512) {
        DBG("[SIG] md5_hex: LOW heap block=%u — hash may be corrupt!\n",
            ESP.getMaxFreeBlockSize());
    }
    MD5Builder b;
    b.begin();
    b.add((const uint8_t*)plain, strlen(plain));
    b.calculate();
    uint8_t digest[16];
    b.getBytes(digest);
    static const char hexch[] = "0123456789abcdef";
    for (int i = 0; i < 16; i++) {
        out[i * 2]     = hexch[(digest[i] >> 4) & 0x0F];
        out[i * 2 + 1] = hexch[digest[i] & 0x0F];
    }
    out[32] = '\0';
}

// Constant-time signature compare — avoids leaking the expected MAC byte by
// byte via response-timing differences. sig is the value received over the
// wire (may be any length/garbage); plain is the already-formatted "psk:..."
// message to hash and compare against.
bool sig_ok_buf(const char* sig, const char* plain) {
    char expected[33];
    md5_hex_buf(plain, expected);
    size_t sigLen = strlen(sig);
    if (sigLen != 32) {
        // Length mismatch is almost always an OOM/fragmentation failure
        // (expected hash truncated) rather than a real bad signature.
        DBG("[SIG] LEN MISMATCH recv_len=%u exp_len=32\n", (unsigned)sigLen);
        DBG("[SIG]   recv=%s\n", sig);
        DBG("[SIG]   exp =%s\n", expected);
        dbgHeap("sig_len_fail");
        return false;
    }
    uint8_t diff = 0;
    for (size_t i = 0; i < 32; i++)
        diff |= (uint8_t)sig[i] ^ (uint8_t)expected[i];
    if (diff != 0) {
        // Correct length but different hash → the PSK stored on this unit does
        // NOT match what the portal signed with. This is the failure that
        // SURVIVES a reboot: check the [BOOT] PSK line against the portal.
        DBG("[SIG] HASH MISMATCH — stored PSK likely differs from portal PSK\n");
        DBG("[SIG]   recv=%s\n", sig);
        DBG("[SIG]   exp =%s\n", expected);
        DBG("[SIG]   psk =%s\n", dbgMask(cfg.psk).c_str());
    }
    return diff == 0;
}

void setCoinAcceptor(bool en) {
    // Re-initialize the pin mode every time, in case a spark reset it
    pinMode(COIN_ENABLE_PIN, OUTPUT);
    digitalWrite(COIN_ENABLE_PIN, en ? COIN_ENABLE_ACTIVE : !COIN_ENABLE_ACTIVE);
}

void IRAM_ATTR onCoinPulse() {
    unsigned long nowUs = micros();
    unsigned long nowMs = millis();
    int currentState = digitalRead(COIN_PIN);

    // ── AUTO-DETECT NO vs NC ─────────────────────────────────────────
    // If the line has been quiet for > 500ms, this edge MUST be 
    // the start of a new coin pulse. We lock in whatever state 
    // it just transitioned TO as the "active" pulse state.
    if (nowMs - lastEdgeMs > 500) {
        activeState = currentState;
        pulseInProgress = false; // Reset in case of prior glitches
    }
    lastEdgeMs = nowMs;

    if (currentState == activeState) {
        // Leading edge: Pulse started. Record it and wait for it to end.
        pulseFallUs = nowUs;
        pulseInProgress = true;
        return;
    }

    // Trailing edge: Pulse ended (returned to resting state).
    if (!pulseInProgress) return;
    pulseInProgress = false;

    // Check pulse width to reject piezo sparks (<8ms) or stuck sensors (>200ms)
    unsigned long widthUs = nowUs - pulseFallUs;
    if (widthUs < PULSE_MIN_WIDTH_US || widthUs > PULSE_MAX_WIDTH_US) return;

    if (sessionActive) {
        // Hardware debounce: ignore physically impossible fast pulses (<15ms).
        unsigned long gap = nowMs - lastPulseMs;
        if (gap < 15) return;

        lastPulseMs    = nowMs;
        coinPesos     += cfg.coin_value;
        sessionStartMs = nowMs;   // each valid coin extends the timeout window
    }
}

// JSON-safe escape (SSIDs can contain quotes/backslashes)
String jsonEscape(const String& s) {
    String r;
    r.reserve(s.length());
    for (char c : s) {
        if      (c == '"')  r += "\\\"";
        else if (c == '\\') r += "\\\\";
        else if (c == '\n') r += "\\n";
        else if (c == '\r') r += "\\r";
        else                r += c;
    }
    return r;
}


// ══════════════════════════════════════════════════════════════════════
// CONFIG STORAGE — LittleFS, KEY=VALUE lines
// ══════════════════════════════════════════════════════════════════════

void setConfigDefaults() {
    strncpy(cfg.ssid,      "",                 sizeof(cfg.ssid));
    strncpy(cfg.pass,      "",                 sizeof(cfg.pass));
    strncpy(cfg.psk,       DEFAULT_PSK,        sizeof(cfg.psk));
    strncpy(cfg.portal_ip, DEFAULT_PORTAL_IP,  sizeof(cfg.portal_ip));
    cfg.portal_port = DEFAULT_PORTAL_PORT;
    cfg.coin_value  = DEFAULT_COIN_VALUE;
    cfg.timeout_sec = DEFAULT_TIMEOUT;
    cfg.cpu_freq_mhz = DEFAULT_CPU_FREQ_MHZ;
}

// Returns true only if config exists and has a valid SSID
bool loadConfig() {
    if (!LittleFS.exists(CONFIG_PATH)) return false;
    File f = LittleFS.open(CONFIG_PATH, "r");
    if (!f) return false;

    while (f.available()) {
        String line = f.readStringUntil('\n');
        line.trim();
        int eq = line.indexOf('=');
        if (eq < 1) continue;
        String k = line.substring(0, eq);
        String v = line.substring(eq + 1);

        if      (k == "SSID")    v.toCharArray(cfg.ssid,      sizeof(cfg.ssid));
        else if (k == "PASS")    v.toCharArray(cfg.pass,      sizeof(cfg.pass));
        else if (k == "PSK")     v.toCharArray(cfg.psk,       sizeof(cfg.psk));
        else if (k == "IP")      v.toCharArray(cfg.portal_ip, sizeof(cfg.portal_ip));
        else if (k == "PORT")    cfg.portal_port = (uint16_t)v.toInt();
        else if (k == "COINVAL") cfg.coin_value  = (uint8_t)v.toInt();
        else if (k == "TIMEOUT") cfg.timeout_sec = (uint8_t)v.toInt();
        else if (k == "CPUFREQ") cfg.cpu_freq_mhz = (v.toInt() == 160) ? 160 : 80;
        // No "else" needed for a missing CPUFREQ key: setConfigDefaults() already
        // seeded cfg.cpu_freq_mhz before this runs, so a config saved by an older
        // firmware version (pre-CPUFREQ) just keeps loading fine at 80MHz.
    }
    f.close();
    return strlen(cfg.ssid) > 0;
}

bool saveConfig() {
    File f = LittleFS.open(CONFIG_PATH, "w");
    if (!f) return false;
    f.println("SSID="    + String(cfg.ssid));
    f.println("PASS="    + String(cfg.pass));
    f.println("PSK="     + String(cfg.psk));
    f.println("IP="      + String(cfg.portal_ip));
    f.println("PORT="    + String(cfg.portal_port));
    f.println("COINVAL=" + String(cfg.coin_value));
    f.println("TIMEOUT=" + String(cfg.timeout_sec));
    f.println("CPUFREQ=" + String(cfg.cpu_freq_mhz));
    f.close();
    return true;
}

void wipeConfig() {
    LittleFS.remove(CONFIG_PATH);
}
// Coins are kept only in RAM (coinPesos). We no longer mirror the session to
// LittleFS — that per-coin flash write was the root cause of the ESP8266 flash
// wear and heap fragmentation (which silently broke md5/sig and produced the
// reboot-proof /start 403s). The router (coin.sh + startup.sh) now persists
// each PSK-verified poll total to non-volatile storage and replays any
// unfinished session across a blackout instead.


