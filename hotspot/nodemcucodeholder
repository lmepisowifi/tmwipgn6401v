void serve_setup_page() {
    setupServer.send_P(200, "text/html", SETUP_PAGE);
}

void handle_scan() {
    // Must be in AP+STA mode for scanning to work while AP is active
    int n = WiFi.scanNetworks();
    String j = "[";
    for (int i = 0; i < n; i++) {
        if (i) j += ",";
        j += "{\"ssid\":\"" + jsonEscape(WiFi.SSID(i)) + "\","
             "\"rssi\":"    + String(WiFi.RSSI(i)) + ","
             "\"enc\":"     + (WiFi.encryptionType(i) == ENC_TYPE_NONE ? "false" : "true") + "}";
    }
    j += "]";
    setupServer.send(200, "application/json", j);
}

void handle_save() {
    String ssid    = setupServer.arg("ssid");
    String pass    = setupServer.arg("pass");
    String psk     = setupServer.arg("psk");
    String ip      = setupServer.arg("ip");
    String port    = setupServer.arg("port");
    String coinval = setupServer.arg("coinval");
    String timeout = setupServer.arg("timeout");
    String cpufreq = setupServer.arg("cpufreq");

    // Strip stray whitespace/CR/newline that commonly rides along when a PSK is
    // copy-pasted from a portal page, chat, or spreadsheet. An invisible
    // trailing byte here is a classic cause of a PERMANENT 403 "bad_sig": the
    // portal signs with the clean PSK, but the unit would store one extra byte,
    // so md5(psk:sid:start) never matches — and a reboot can't fix a bad byte
    // that's already been written to flash. Trim before storing.
    psk.trim();
    ip.trim();

    if (ssid.length() == 0 || ssid.length() > 63) {
        setupServer.send(200, "application/json", "{\"ok\":false,\"error\":\"Invalid SSID\"}");
        return;
    }
    if (psk.length() == 0 || psk.length() > 127) {
        setupServer.send(200, "application/json", "{\"ok\":false,\"error\":\"PSK required (max 127 chars)\"}");
        return;
    }
    if (ip.length() == 0) ip = DEFAULT_PORTAL_IP;

    ssid.toCharArray(cfg.ssid,      sizeof(cfg.ssid));
    pass.toCharArray(cfg.pass,      sizeof(cfg.pass));
    psk.toCharArray(cfg.psk,        sizeof(cfg.psk));
    ip.toCharArray(cfg.portal_ip,   sizeof(cfg.portal_ip));
    cfg.portal_port = port.toInt()    > 0 ? (uint16_t)port.toInt()    : DEFAULT_PORTAL_PORT;
    cfg.coin_value  = coinval.toInt() > 0 ? (uint8_t)coinval.toInt()  : DEFAULT_COIN_VALUE;
    cfg.timeout_sec = timeout.toInt() > 0 ? (uint8_t)timeout.toInt()  : DEFAULT_TIMEOUT;
    cfg.cpu_freq_mhz = (cpufreq.toInt() == 160) ? 160 : 80;   // anything else (blank, garbage) → safe 80MHz default

    if (saveConfig()) {
        setupServer.send(200, "application/json", "{\"ok\":true}");
        delay(1500);
        ESP.restart();
    } else {
        setupServer.send(200, "application/json",
            "{\"ok\":false,\"error\":\"LittleFS write failed — check partition table\"}");
    }
}

void startSetupMode() {
    isSetupMode = true;
    // AP+STA so we can scan WiFi networks while hosting the AP
    WiFi.mode(WIFI_AP_STA);
    WiFi.softAP(AP_SSID);  // open — no password

    setupServer.on("/",     HTTP_GET,  serve_setup_page);
    setupServer.on("/scan", HTTP_GET,  handle_scan);
    setupServer.on("/save", HTTP_POST, handle_save);
    // Redirect everything else to the setup page
    setupServer.onNotFound([]() {
        setupServer.sendHeader("Location", "/", true);
        setupServer.send(302, "text/plain", "");
    });
    setupServer.begin();
}


// ══════════════════════════════════════════════════════════════════════
// NORMAL MODE — Coin slot + admin, server on port 8080
// ══════════════════════════════════════════════════════════════════════

void post_result() {
    if (WiFi.status() != WL_CONNECTED) return;
    HTTPClient http;
    char url[64];
    snprintf(url, sizeof(url), "http://%s:%u/cgi-bin/coin_result.sh",
             cfg.portal_ip, cfg.portal_port);
    http.begin(wifiClient, url);
    // Kept comfortably under the portal's own 2s wget timeout on /status
    // (both the resume-check and each poll attempt) — this call blocks
    // loop() (and therefore coinServer.handleClient()) for up to this long
    // on every session finalize, so anything above ~2s risks the portal
    // seeing "no response" from a unit that's simply busy reporting its
    // own result. A failed attempt just falls back to the existing 5s/10x
    // retry loop in loop(), so shortening this costs nothing on a healthy
    // LAN and only bounds the worst case.
    http.setTimeout(1500);
    http.addHeader("Content-Type", "application/x-www-form-urlencoded");
    // Post the fixed buffer directly by length — no String wrapper needed.
    if (http.POST((uint8_t*)pendingBody, strlen(pendingBody)) > 0) {
        if (http.getString().indexOf("\"ok\":true") >= 0) {
            pendingResult  = false;
            pendingBody[0] = '\0';
            pendingRetries = 0;
        }
    }
    http.end();
}

void endSession() {
    setCoinAcceptor(false);         // block coins immediately
    sessionActive  = false;
    finalizing     = false;
    countdownPaused = false;
    sessionStartMs = 0;

    int finalAmount = coinPesos;
    coinPesos = 0;

    char plain[SIG_PLAIN_LEN], sig[33];
    snprintf(plain, sizeof(plain), "%s:%s:%d:end", cfg.psk, activeSid, finalAmount);
    md5_hex_buf(plain, sig);
    snprintf(pendingBody, sizeof(pendingBody), "sid=%s&amount=%d&sig=%s",
             activeSid, finalAmount, sig);
    pendingRetries = 0;
    pendingResult  = true;
    activeSid[0]   = '\0';
    lastSessionEndMs = millis();   // start the post-session grace clock for any queued reboot
    post_result();
}

// ── DEFERRED REBOOT SERVICE ────────────────────────────────────────
// Called every loop(). Decides WHEN to reboot, never interrupting a paying
// customer:
//   1. Queue a reboot if the daily interval elapsed, or if free heap has
//      been below the danger floor for HEAP_LOW_CONFIRM checks in a row.
//   2. Once queued, hold off while a coin session is active/finalizing
//      (someone is inserting coins), then wait POST_SESSION_WAIT_MS after it
//      ends and re-check — if a NEW session started in that minute, wait
//      again. Only reboot once the machine has been idle for the full grace
//      minute.
void serviceReboot() {
    static unsigned long bootMs      = millis();
    static unsigned long lastHeapChk = 0;
    static uint8_t       heapStrikes = 0;

    // 1a) Scheduled interval reached? (elapsed-subtraction is rollover-safe)
    if (!rebootPending && (millis() - bootMs) >= REBOOT_INTERVAL_MS) {
        rebootPending = true;
        rebootReason  = "scheduled";
    }

    // 1b) Heap watchdog — sample periodically, require consecutive bad reads.
    // Trip on ANY of: low total free heap, a too-small largest contiguous
    // block, or high fragmentation. The block/fragmentation checks are what
    // actually catch the "signing silently breaks → 403 on /start" failure:
    // total free heap can look fine while the largest allocatable block is too
    // small for md5_hex()/sig_ok() to build their Strings.
    if (millis() - lastHeapChk >= HEAP_CHECK_MS) {
        lastHeapChk = millis();
        uint32_t freeHeap  = ESP.getFreeHeap();
        uint32_t maxBlock  = ESP.getMaxFreeBlockSize();
        uint8_t  fragPct   = ESP.getHeapFragmentation();
        bool starved   = freeHeap < HEAP_LOW_BYTES;
        bool blockLow  = maxBlock < HEAP_BLOCK_LOW_BYTES;
        bool tooFrag   = fragPct  > HEAP_FRAG_HIGH_PCT;
        // Periodic heartbeat so you can watch the heap slowly fragment over
        // hours/days in the Serial Monitor and correlate it with /start 403s.
        DBG("[WDOG] free=%u maxBlock=%u frag=%u%% strikes=%u\n",
            freeHeap, maxBlock, fragPct, heapStrikes);
        if (starved || blockLow || tooFrag) {
            if (++heapStrikes >= HEAP_LOW_CONFIRM && !rebootPending) {
                rebootPending = true;
                rebootReason  = starved ? "low_heap"
                                        : (blockLow ? "heap_block_low" : "heap_frag");
                DBG("[WDOG] reboot QUEUED reason=%s (free=%u maxBlock=%u frag=%u%%)\n",
                    rebootReason, freeHeap, maxBlock, fragPct);
            }
        } else {
            heapStrikes = 0;   // recovered — reset the strike counter
        }
    }

    if (!rebootPending) return;

    // 2) A reboot is queued — but never cut off a paying customer.
    if (sessionActive || finalizing) return;                          // coins being inserted → wait
    if ((millis() - lastSessionEndMs) < POST_SESSION_WAIT_MS) return; // grace minute not up, or a new session just started

    // Idle, grace minute elapsed, no new session → safe to reboot now.
    DBG("[WDOG] rebooting now, reason=%s\n", rebootReason);
    setCoinAcceptor(false);   // make sure the slot is blocked across the reboot
    delay(50);
    ESP.restart();
}

void handle_coin_start() {
    if (sessionActive && coinServer.arg("sid") == activeSid) {
        coinServer.send(200, "application/json", "{\"ok\":true,\"resumed\":true}");
        return;
    }
    if (sessionActive) {
        coinServer.send(409, "application/json", "{\"ok\":false,\"error\":\"busy\"}");
        return;
    }

    String sid = coinServer.arg("sid");
    String sig = coinServer.arg("sig");
    String to  = coinServer.arg("timeout");

    DBG("[START] sid=%s sig=%s\n", sid.c_str(), sig.c_str());
    dbgHeap("start_req");

    if (sid.length() != 16) {
        DBG("[START] REJECT 400 bad_sid (len=%u)\n", sid.length());
        coinServer.send(400, "application/json", "{\"ok\":false,\"error\":\"bad_sid\"}");
        return;
    }

    // OOM GUARD — the difference between a self-healing unit and a "dead" one.
    // If the largest free heap block is too small to reliably build the
    // signature String + MD5 buffers, DON'T compute a corrupt hash and reject
    // with a permanent-looking 403. Instead return a RETRYABLE 503 and queue a
    // reboot to defragment. The portal can retry, and after the idle reboot the
    // unit comes back healthy — no manual power cycle, no "destroys itself".
    if (ESP.getMaxFreeBlockSize() < HEAP_BLOCK_LOW_BYTES) {
        DBG("[START] REJECT 503 low_heap maxBlock=%u — queuing reboot\n",
            ESP.getMaxFreeBlockSize());
        if (!rebootPending) { rebootPending = true; rebootReason = "heap_block_low"; }
        coinServer.send(503, "application/json",
                        "{\"ok\":false,\"error\":\"busy_retry\"}");
        return;
    }

    char plain[SIG_PLAIN_LEN];
    snprintf(plain, sizeof(plain), "%s:%s:start", cfg.psk, sid.c_str());
    if (!sig_ok_buf(sig.c_str(), plain)) {
        // sig_ok_buf() has already logged WHY (heap/OOM vs PSK mismatch) above.
        DBGLN("[START] REJECT 403 bad_sig — see [SIG] lines above for cause");
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"bad_sig\"}");
        return;
    }
    DBGLN("[START] OK — session accepted");

sessionActive    = true;
    finalizing       = false;
    cancelRequested  = false;
    sid.toCharArray(activeSid, sizeof(activeSid));  // sid.length()==16, validated above
    coinPesos        = 0;
    sessionStartMs   = millis();
    // Back-dated, not "now": onCoinPulse()'s 15ms debounce guard below
    // treats (nowMs - lastPulseMs) < 15 as the SAME physical coin bouncing,
    // and exists only to catch that. Stamping it to "now" at session start
    // made it also apply across the session boundary — a customer who has a
    // coin already at the gate when the slot goes live can have that first
    // coin's trailing edge land within 15ms of this line, so a perfectly
    // legitimate first coin was silently discarded as a "bounce" of a coin
    // that never happened. Backdating it means the very first real coin of
    // a session is never compared against session-start; every later coin
    // in the session still debounces normally against the previous one.
    lastPulseMs      = millis() - 1000;
    lastPollMs       = millis(); // the /start request itself counts as fresh contact
    countdownPaused  = false;

    // Re-anchor the pulse auto-detect state machine right as the slot goes live.
    // While idle/inhibited, a stray EMI edge on COIN_PIN can leave a half-finished
    // pulse in flight; that stale pulseInProgress flag gets compared against the
    // customer's actual first coin and can misread or drop it with nothing visible
    // to show why. Clear it so the first real coin of this session is judged fresh.
    //
    // We do NOT touch activeState here. activeState records which logic level the
    // acceptor's opto pulls TO during a real pulse (NO vs NC) — a fixed hardware
    // property that doesn't change between sessions, so the value already learned
    // from a prior real edge is correct and should be left alone. digitalRead()'ing
    // COIN_PIN here would only capture the RESTING level (the slot is still
    // inhibited at this point — setCoinAcceptor(true) hasn't run yet), and storing
    // that into activeState inverts the polarity: a coin already waiting at the
    // gate that drops the instant the slot opens (within the 500ms auto-detect
    // window below) would then have its leading edge ignored and its trailing edge
    // misread as a new pulse starting — silently swallowing exactly the "inserted
    // immediately when allowed" coin. Backdating lastEdgeMs instead guarantees the
    // very next real edge (whenever it arrives) is treated as fresh by the ISR's
    // own auto-detect branch, which derives activeState from an actual transition
    // rather than a guess.
    noInterrupts();
    pulseInProgress = false;
    lastEdgeMs      = millis() - 501;  // force next edge through auto-detect, see above
    interrupts();
    
    sessionTimeoutMs = (to.length() > 0)
                       ? (unsigned long)to.toInt() * 1000UL
                       : (unsigned long)cfg.timeout_sec * 1000UL;
    setCoinAcceptor(true);
    coinServer.send(200, "application/json", "{\"ok\":true}");
}

// Ends the session early on the user's signal ("Done" / "Cancel" in the UI).
// Does NOT call endSession() directly — see loop() for why.
void handle_coin_cancel() {
    String sid = coinServer.arg("sid");
    String sig = coinServer.arg("sig");

    // Already ended (timed out naturally just before this arrived, or a duplicate click)
    if (!sessionActive || sid != activeSid) {
        coinServer.send(200, "application/json", "{\"ok\":true,\"msg\":\"already_ended\"}");
        return;
    }
    char plain[SIG_PLAIN_LEN];
    snprintf(plain, sizeof(plain), "%s:%s:cancel", cfg.psk, sid.c_str());
    if (!sig_ok_buf(sig.c_str(), plain)) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"bad_sig\"}");
        return;
    }

    // Just signal — loop() picks this up so it can wait for trailing coin pulses securely
    cancelRequested = true;
    coinServer.send(200, "application/json", "{\"ok\":true}");
}

void handle_coin_status() {
    String sid = coinServer.arg("sid");
    String sig = coinServer.arg("sig");

    if (sid != activeSid || !sessionActive) {
        // The portal's wget only ever reads a 2xx response body — a 404
        // here was INDISTINGUISHABLE FROM NO REPLY AT ALL on that end, so a
        // sid this unit legitimately just finished (normal timeout/Done/
        // Cancel, or a reboot) got misreported upstream as "offline"
        // instead of "confirmed gone". Answer 200 and sign it the SAME way
        // the live status reply below signs "amount" (psk:sid:amount:
        // status, amount pinned to 0) so the portal's existing signature
        // check accepts it with no wire-format change there. The explicit
        // "active":false is what lets an updated portal tell this apart
        // from a genuine live session sitting at zero coins, instead of
        // treating the two the same and zeroing out a real balance.
        char plain0[SIG_PLAIN_LEN], sig0[33], resp0[128];
        snprintf(plain0, sizeof(plain0), "%s:%s:0:status", cfg.psk, sid.c_str());
        md5_hex_buf(plain0, sig0);
        snprintf(resp0, sizeof(resp0),
                 "{\"ok\":false,\"active\":false,\"amount\":0,\"sig\":\"%s\"}", sig0);
        coinServer.send(200, "application/json", resp0);
        return;
    }
    char plainPoll[SIG_PLAIN_LEN];
    snprintf(plainPoll, sizeof(plainPoll), "%s:%s:poll", cfg.psk, sid.c_str());
    if (!sig_ok_buf(sig.c_str(), plainPoll)) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"bad_sig\"}");
        return;
    }

    // A verified poll landed → the portal link is alive. Record it so the
    // link-loss watchdog in loop() knows the countdown may keep running, and
    // un-pause: while paused, loop() froze the window by advancing
    // sessionStartMs every tick, so simply clearing the flag resumes the
    // countdown exactly where it left off — no coin-insert time was consumed
    // while the portal was unreachable.
    lastPollMs = millis();
    countdownPaused = false;

    int amt = coinPesos;

    long remMs = (long)sessionTimeoutMs - (long)(millis() - sessionStartMs);
    if (remMs < 0) remMs = 0;
    int remaining = remMs / 1000;

    char plain2[SIG_PLAIN_LEN], sig2[33], resp2[160];
    snprintf(plain2, sizeof(plain2), "%s:%s:%d:status", cfg.psk, sid.c_str(), amt);
    md5_hex_buf(plain2, sig2);
    snprintf(resp2, sizeof(resp2),
             "{\"ok\":true,\"amount\":%d,\"remaining\":%d,\"sig\":\"%s\"}",
             amt, remaining, sig2);
    coinServer.send(200, "application/json", resp2);
}

// Soft factory reset — only accepts requests from the portal IP
// Issues a fresh one-time nonce for the signed reset flow. Restricted to the
// portal IP so a random hotspot client can't farm nonces; the nonce is
// useless anyway without the PSK to sign it.
void handle_nonce() {
    // Compare IPAddress objects directly — was two String allocations
    // (.toString() + String(cfg.portal_ip)) on every single admin request.
    if (coinServer.client().remoteIP() != portalIPAddr) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"forbidden\"}");
        return;
    }
    char buf[17];
    snprintf(buf, sizeof(buf), "%08x%08x",
             (unsigned)os_random(), (unsigned)os_random());
    resetNonce    = String(buf);
    nonceIssuedMs = millis();
    char resp[48];
    snprintf(resp, sizeof(resp), "{\"ok\":true,\"nonce\":\"%s\"}", buf);
    coinServer.send(200, "application/json", resp);
}

void handle_admin_reset() {
    // Compare IPAddress objects directly — was two String allocations
    // (.toString() + String(cfg.portal_ip)) on every single admin request.
    if (coinServer.client().remoteIP() != portalIPAddr) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"forbidden\"}");
        return;
    }
    // Require a fresh, single-use nonce signed with the PSK:
    //   token = md5(PSK:nonce:reset)   (matches coin.sh's reset flow)
    // The old code trusted the source IP alone (spoofable on the shared
    // hotspot LAN), making /reset an unauthenticated config-wipe DoS.
    if (resetNonce.length() == 0 || (millis() - nonceIssuedMs) > NONCE_TTL_MS) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"no_nonce\"}");
        return;
    }
    String token = coinServer.arg("token");
    char plainRst[SIG_PLAIN_LEN];
    snprintf(plainRst, sizeof(plainRst), "%s:%s:reset", cfg.psk, resetNonce.c_str());
    bool good = sig_ok_buf(token.c_str(), plainRst);
    resetNonce = "";   // single-use: burn the nonce regardless of outcome
    if (!good) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"bad_token\"}");
        return;
    }
    coinServer.send(200, "application/json",
        "{\"ok\":true,\"msg\":\"wiped, rebooting into setup AP\"}");
    wipeConfig();
    delay(1000);
    ESP.restart();
}

// /setwifi — the portal (wlanbasic.cgi) hands us the NEW credentials for the
// SSID we ride on, right before it retunes that AP. We save them, ACK, and
// switch over a moment later (see wifiChangePending in loop) so this reply is
// delivered and the AP has time to come up on the new name first. Without this
// handshake, renaming the AP would silently strand the coin slot offline.
//
// Auth mirrors /reset: portal-IP only + a single-use, PSK-signed nonce that
// also binds the exact ssid+pass:  token = md5(PSK:nonce:ssid:pass:setwifi)
void handle_set_wifi() {
    // Compare IPAddress objects directly — was two String allocations
    // (.toString() + String(cfg.portal_ip)) on every single admin request.
    if (coinServer.client().remoteIP() != portalIPAddr) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"forbidden\"}");
        return;
    }
    if (resetNonce.length() == 0 || (millis() - nonceIssuedMs) > NONCE_TTL_MS) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"no_nonce\"}");
        return;
    }
    String newSsid = coinServer.arg("ssid");
    String newPass = coinServer.arg("pass");
    String token   = coinServer.arg("token");
    char plainWifi[SIG_PLAIN_LEN];
    snprintf(plainWifi, sizeof(plainWifi), "%s:%s:%s:%s:setwifi",
             cfg.psk, resetNonce.c_str(), newSsid.c_str(), newPass.c_str());
    bool good = sig_ok_buf(token.c_str(), plainWifi);
    resetNonce = "";   // single-use: burn the nonce regardless of outcome
    if (!good) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"bad_token\"}");
        return;
    }
    if (newSsid.length() == 0 || newSsid.length() > 63) {
        coinServer.send(200, "application/json", "{\"ok\":false,\"error\":\"bad_ssid\"}");
        return;
    }
    if (newPass.length() > 63) {   // WPA-PSK max, and fits cfg.pass[64]
        coinServer.send(200, "application/json", "{\"ok\":false,\"error\":\"bad_pass\"}");
        return;
    }
    // Persist the new credentials now, but keep the current link up until we
    // ACK. The actual re-association is deferred to loop() so this response is
    // delivered and the portal can switch the AP over first.
    newSsid.toCharArray(cfg.ssid, sizeof(cfg.ssid));
    newPass.toCharArray(cfg.pass, sizeof(cfg.pass));
    bool saved = saveConfig();
    char resp[96];
    snprintf(resp, sizeof(resp),
             "{\"ok\":%s,\"msg\":\"credentials accepted, switching shortly\"}",
             saved ? "true" : "false");
    coinServer.send(200, "application/json", resp);
    if (saved) {
        wifiChangePending = true;
        wifiChangeReqMs   = millis();   // apply after WIFI_CHANGE_DELAY_MS elapses
    }
}

// /setfreq — portal-triggered CPU frequency change. Unlike /setwifi (which
// defers and reconnects in-place), a frequency switch just reboots: the new
// value is picked up by preloop_update_frequency() from the very first loop
// after boot, and a reboot only takes ~1-2s versus the complexity of trying
// to hot-swap frequency mid-session.
//
// Auth mirrors /reset and /setwifi exactly: portal-IP only + a single-use,
// PSK-signed nonce that also binds the requested value:
//   token = md5(PSK:nonce:freq:setfreq)
void handle_set_freq() {
    // Compare IPAddress objects directly — was two String allocations
    // (.toString() + String(cfg.portal_ip)) on every single admin request.
    if (coinServer.client().remoteIP() != portalIPAddr) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"forbidden\"}");
        return;
    }
    if (resetNonce.length() == 0 || (millis() - nonceIssuedMs) > NONCE_TTL_MS) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"no_nonce\"}");
        return;
    }
    String freq  = coinServer.arg("freq");
    String token = coinServer.arg("token");
    char plainFreq[SIG_PLAIN_LEN];
    snprintf(plainFreq, sizeof(plainFreq), "%s:%s:%s:setfreq",
             cfg.psk, resetNonce.c_str(), freq.c_str());
    bool good = sig_ok_buf(token.c_str(), plainFreq);
    resetNonce = "";   // single-use: burn the nonce regardless of outcome
    if (!good) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"bad_token\"}");
        return;
    }
    int mhz = freq.toInt();
    if (mhz != 80 && mhz != 160) {
        coinServer.send(200, "application/json", "{\"ok\":false,\"error\":\"bad_freq\"}");
        return;
    }
    // Refuse mid-session: same reasoning as /update's "busy" gate — a reboot
    // right now would drop a customer's coin session and lose any pulses
    // still in flight, so make the caller retry once the unit is idle.
    if (sessionActive) {
        coinServer.send(200, "application/json", "{\"ok\":false,\"error\":\"busy\"}");
        return;
    }
    cfg.cpu_freq_mhz = (uint8_t)mhz;
    bool saved = saveConfig();
    char resp[80];
    snprintf(resp, sizeof(resp), "{\"ok\":%s,\"msg\":\"rebooting at %dMHz\"}",
             saved ? "true" : "false", mhz);
    coinServer.send(200, "application/json", resp);
    if (saved) {
        delay(500);   // let the HTTP response actually drain before we drop the link
        ESP.restart();
    }
}

// ── OTA SELF-UPDATE ──────────────────────────────────────────────────────────
// The portal (ota.sh) pushes a new firmware image to us as part of its own OTA,
// but ONLY when our FW_VERSION differs from the release. Auth + flow mirror the
// /reset and /setwifi endpoints exactly:
//
//   portal: GET /version                     → {"ok":true,"fw":"x.y.z"}   (gate)
//   portal: GET /nonce                        → fresh single-use nonce
//   portal: GET /update?md5=<hex>&token=<t>    t = md5(PSK:nonce:md5:update)
//
// On a valid signed request we pull the .bin from OUR OWN portal over the
// already-trusted hotspot LAN (cfg.portal_ip:cfg.portal_port, /firmware/
// coin_nodemcu.bin) — no TLS, no GitHub on the ESP — self-flash it with an
// ENFORCED MD5 check, and reboot. On ANY failure (bad token, short download,
// MD5 mismatch) the new image is never committed: Update leaves the running
// firmware active, so a corrupt or spoofed push cannot brick the coin slot.
//
// FLASH-LAYOUT REQUIREMENT: build with a size that reserves an OTA region,
// e.g. arduino-cli FQBN option ...:eesz=4M2M (4MB flash / 2MB FS) or the
// Arduino IDE "Flash Size: 4MB (FS:1MB OTA:~1019KB)". Without an OTA slot,
// Update.begin() will fail and the push is safely refused.

// Report running firmware version. Portal-IP only — no reason to let a random
// hotspot client fingerprint the coin slot's firmware.
void handle_version() {
    // Compare IPAddress objects directly — was two String allocations
    // (.toString() + String(cfg.portal_ip)) on every single admin request.
    if (coinServer.client().remoteIP() != portalIPAddr) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"forbidden\"}");
        return;
    }
    // Read the actual hardware register (bit 0 of CPU2X: 1 = 160MHz, 0 = 80MHz)
    int actual_mhz = (CPU2X & 1) ? 160 : 80;

    char resp[80];
    snprintf(resp, sizeof(resp), "{\"ok\":true,\"fw\":\"%s\",\"cpu_mhz\":%d}",
             FW_VERSION, actual_mhz);
    coinServer.send(200, "application/json", resp);
}

void handle_update() {
    // Compare IPAddress objects directly — was two String allocations
    // (.toString() + String(cfg.portal_ip)) on every single admin request.
    if (coinServer.client().remoteIP() != portalIPAddr) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"forbidden\"}");
        return;
    }
    if (resetNonce.length() == 0 || (millis() - nonceIssuedMs) > NONCE_TTL_MS) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"no_nonce\"}");
        return;
    }
    String md5   = coinServer.arg("md5");
    String token = coinServer.arg("token");
    
    // Signed, single-use, and bound to the exact image we may flash:
    char plainUpd[SIG_PLAIN_LEN];
    snprintf(plainUpd, sizeof(plainUpd), "%s:%s:%s:update",
             cfg.psk, resetNonce.c_str(), md5.c_str());
    bool good = sig_ok_buf(token.c_str(), plainUpd);
    resetNonce = "";   // single-use: burn the nonce regardless of outcome
    if (!good) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"bad_token\"}");
        return;
    }
    md5.toLowerCase();
    if (md5.length() != 32) {
        coinServer.send(200, "application/json", "{\"ok\":false,\"error\":\"bad_md5\"}");
        return;
    }
    // Never interrupt a paying customer — the portal retries on its next run.
    if (sessionActive || finalizing) {
        coinServer.send(200, "application/json", "{\"ok\":false,\"error\":\"busy\"}");
        return;
    }
    
    // ACK first so the portal's wget gets a definitive reply before we spend
    // several seconds downloading + flashing (and then rebooting on success).
    coinServer.send(200, "application/json", "{\"ok\":true,\"msg\":\"updating, will reboot on success\"}");
    delay(50);                 // let the reply drain before we block on the download

    setCoinAcceptor(false);    // block coins while we flash

    // Pull from our own portal over the trusted hotspot LAN
    char url[80];
    snprintf(url, sizeof(url), "http://%s:%u/firmware/coin_nodemcu.bin",
             cfg.portal_ip, cfg.portal_port);
    WiFiClient uc;
    HTTPClient http;
    
    // Force HTTP/1.0 to completely bypass chunked encoding issues
    http.useHTTP10(true); 

    if (!http.begin(uc, url)) {
        Serial.println("OTA: http.begin failed");
        return;
    }
    
    http.setTimeout(20000);
    int code = http.GET();
    Serial.printf("OTA HTTP %d\n", code);

    if (code != HTTP_CODE_OK) {
        http.end();
        return;
    }
    
    int len = http.getSize();
    Serial.printf("OTA size=%d\n", len);
    if (len <= 0) { http.end(); return; }

    if (!Update.begin((size_t)len)) {
        Serial.printf("Update.begin failed: %s\n", Update.getErrorString());
        http.end();
        return;
    }
    
    Update.setMD5(md5.c_str()); // Enforce integrity

// ── ROBUST CHUNK LOOP ──
    WiFiClient* stream = http.getStreamPtr();
    uint8_t buff[1024]; // 1KB buffer matches TCP packet sizes better
    size_t written = 0;
    unsigned long lastDataTime = millis();

    Serial.println("Starting robust chunk write...");

    while (http.connected() && written < (size_t)len) {
        size_t available_bytes = stream->available();

        if (available_bytes > 0) {
            int bytesRead = stream->readBytes(buff, min(available_bytes, sizeof(buff)));
            if (bytesRead > 0) {
                Update.write(buff, bytesRead);
                written += bytesRead;
                lastDataTime = millis(); // Reset stream timer
            }
        } else {
            delay(10);
            yield(); // Feed the ESP8266 network stack and software watchdog
            
            // Allow up to 15 seconds for Wi-Fi congestion / TCP retransmits
            if (millis() - lastDataTime > 15000) { 
                Serial.println("\nOTA Error: Stream went dry.");
                break;
            }
        }
        yield();
    }

    Serial.printf("Written %u/%d\n", written, len);
    http.end();

    if (written == (size_t)len) {
        if (Update.end()) {
            Serial.println("OTA Success! Rebooting into new firmware...");
            delay(200);
            ESP.restart(); // Boot into the new image
        } else {
            Serial.printf("Update.end failed: %s\n", Update.getErrorString());
        }
    } else {
        Serial.println("Update aborted: File size mismatch.");
        Update.end(); 
    }
}


bool connectWiFi() {
    WiFi.persistent(false);
    WiFi.mode(WIFI_STA);
    WiFi.setSleepMode(WIFI_NONE_SLEEP);
    WiFi.setAutoReconnect(true);

    // ── ACTIVE SCAN LOOP ──
    // Re-check/re-trigger every 15 seconds to give full time for 
    // channel scan, WPA2 handshake, and DHCP without interruptions.
    const unsigned long MAX_BOOT_WAIT_MS = 120000UL; // 2 min total timeout
    const unsigned long RETRY_INTERVAL_MS = 15000UL; // 15s retry interval
    unsigned long start = millis();
    unsigned long lastAttemptMs = 0;

    while (WiFi.status() != WL_CONNECTED && (millis() - start) < MAX_BOOT_WAIT_MS) {
        if (millis() - lastAttemptMs >= RETRY_INTERVAL_MS) {
            lastAttemptMs = millis();
            WiFi.begin(cfg.ssid, cfg.pass);
        }
        delay(250);
        yield();
    }

    if (WiFi.status() != WL_CONNECTED) return false;

    // Fast gateway verification (clean re-DHCP if initially on br0)
    const unsigned long GW_WAIT_MS = 30000UL;
    unsigned long gwStart = millis();
    while (WiFi.gatewayIP() != portalIPAddr) {
        if (millis() - gwStart >= GW_WAIT_MS) {
            return false;
        }
        delay(2500);
        yield();
        WiFi.disconnect(false);
        delay(100);
        WiFi.begin(cfg.ssid, cfg.pass);
        
        unsigned long rStart = millis();
        while (WiFi.status() != WL_CONNECTED && (millis() - rStart) < 8000UL) {
            delay(250);
            yield();
        }
        if (WiFi.status() != WL_CONNECTED) return false;
    }

    return true;
}

void handle_reboot() {
    // Compare IPAddress objects directly — was two String allocations
    // (.toString() + String(cfg.portal_ip)) on every single admin request.
    if (coinServer.client().remoteIP() != portalIPAddr) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"forbidden\"}");
        return;
    }
    if (resetNonce.length() == 0 || (millis() - nonceIssuedMs) > NONCE_TTL_MS) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"no_nonce\"}");
        return;
    }
    String token = coinServer.arg("token");
    char plainRbt[SIG_PLAIN_LEN];
    snprintf(plainRbt, sizeof(plainRbt), "%s:%s:reboot", cfg.psk, resetNonce.c_str());
    bool good = sig_ok_buf(token.c_str(), plainRbt);
    resetNonce = "";   // burn nonce
    if (!good) {
        coinServer.send(403, "application/json", "{\"ok\":false,\"error\":\"bad_token\"}");
        return;
    }
    // Don't reboot if a customer is dropping coins
    if (sessionActive || finalizing) {
        coinServer.send(200, "application/json", "{\"ok\":false,\"error\":\"busy\"}");
        return;
    }
    coinServer.send(200, "application/json", "{\"ok\":true,\"msg\":\"rebooting now\"}");
    delay(500);
    ESP.restart();
}

void startNormalMode() {
    isSetupMode = false;
    portalIPAddr.fromString(cfg.portal_ip);   // parse once; see portalIPAddr declaration

    // Best-effort connect. CRITICAL: never wipeConfig() on failure here. At
    // cold boot the ONT hotspot AP may simply not be up yet, and erasing the
    // saved credentials is what made the device "reset itself" into setup mode
    // during ONT boot. Instead we always start the coin server and let the
    // loop() watchdog + SDK auto-reconnect keep trying until the AP appears.
    // Genuinely-wrong credentials are recovered via the D1 factory-reset button
    // or the signed /reset endpoint — not by self-wiping on a transient miss.
    connectWiFi();

    coinServer.on("/start",   handle_coin_start);
    coinServer.on("/status",  handle_coin_status);
    coinServer.on("/cancel",  handle_coin_cancel);
    coinServer.on("/nonce",   handle_nonce);
    coinServer.on("/reset",   handle_admin_reset);
    coinServer.on("/setwifi", handle_set_wifi);
    coinServer.on("/version", handle_version);
    coinServer.on("/update",  handle_update);
    coinServer.on("/setfreq", handle_set_freq);
    coinServer.on("/reboot",  handle_reboot);
    coinServer.begin();
}

// ── RUNTIME CPU FREQUENCY CONTROL ──────────────────────────────────────
// The ESP8266 Arduino core does NOT support changing CPU frequency at
// runtime out of the box: whatever "CPU Frequency" you pick in the board
// menu (80 or 160MHz) gets baked in as the F_CPU macro, and the core
// silently RE-ASSERTS that compiled-in value on every single loop()
// iteration via a hook called preloop_update_frequency() (see
// core_esp8266_main.cpp). Calling system_update_cpu_freq() on its own
// would get stomped back within microseconds, on the very next loop.
//
// preloop_update_frequency() is declared __attribute__((weak)) specifically
// so a sketch can replace it — which is what we do here: instead of
// reasserting the compile-time F_CPU value, we reassert cfg.cpu_freq_mhz
// (loaded from /cfg.txt) every loop. Same self-healing mechanism the core
// uses, just config-driven instead of compile-time-driven. This means the
// board's own "CPU Frequency" menu selection no longer matters at all —
// compile with either setting, cfg.cpu_freq_mhz is what actually wins.
//
// NOTE: this fires once BEFORE setup() even runs (cfg is still
// zero-initialized then), so the very first instant after boot is at the
// SDK's own default (80MHz) regardless — completely harmless, and every
// loop after setup() has loaded the real config applies the right value.
extern "C" void preloop_update_frequency() {
    if (cfg.cpu_freq_mhz == 160) {
        ets_update_cpu_frequency(160);
        CPU2X |= 1UL;
    } else {
        ets_update_cpu_frequency(80);
        CPU2X &= ~1UL;
    }
}


// ══════════════════════════════════════════════════════════════════════
// ARDUINO SETUP & LOOP
// ══════════════════════════════════════════════════════════════════════

void setup() {
    // Bring up the hardware serial FIRST so every diagnostic below (and the
    // OTA prints further down) actually reach the Arduino IDE Serial Monitor.
    // Open the monitor at 115200 baud. Previously Serial was never started, so
    // all the Serial.printf() calls in the OTA path were silently discarded.
    Serial.begin(115200);
    delay(50);
    Serial.println();
    Serial.println("[BOOT] ==== coin acceptor firmware starting ====");
    Serial.printf("[BOOT] reset reason: %s\n", ESP.getResetReason().c_str());
    dbgHeap("boot");

        pinMode(D0, INPUT_PULLUP);
    pinMode(D2, INPUT_PULLUP);
    pinMode(D3, INPUT_PULLUP); // Has on-board 10k pullup, but software pullup adds stability
    pinMode(D4, INPUT_PULLUP); // Has on-board LED, safe to pull up
    pinMode(D5, INPUT_PULLUP);
    pinMode(COIN_PIN,        INPUT_PULLUP);
    pinMode(COIN_ENABLE_PIN, OUTPUT);
    setCoinAcceptor(false);   // block coins on boot until a session starts

    // ── Factory reset via D1 button held 3s ─────────────────────────
    // Wire a momentary button between D1 (GPIO5) and GND.
    // Hold during power-on → wipes /cfg.txt → reboots into setup AP.
    pinMode(RESET_PIN, INPUT_PULLUP);
    if (digitalRead(RESET_PIN) == LOW) {
        unsigned long held = millis();
        while (digitalRead(RESET_PIN) == LOW) {
            if (millis() - held > 3000) {
                if (LittleFS.begin()) wipeConfig();
                delay(200);
                ESP.restart();
            }
        }
        // Released before 3s — normal boot, don't reset
    }

    attachInterrupt(digitalPinToInterrupt(COIN_PIN), onCoinPulse, CHANGE);

    setConfigDefaults();

    if (!LittleFS.begin()) {
        // Filesystem mount failed — can't save config, go to setup mode
        // (setup page will show save error; owner should check partition table)
        startSetupMode();
        return;
    }

    if (loadConfig()) {
        // Print exactly what was loaded from flash. If /start 403s survive a
        // reboot, this line is the first thing to check: a blank/truncated PSK
        // here (or one that differs from the portal's) explains a persistent
        // "bad_sig" that no amount of rebooting can fix.
        DBG("[BOOT] config loaded: SSID=%s PSK=%s portal=%s:%u\n",
            cfg.ssid, dbgMask(cfg.psk).c_str(), cfg.portal_ip, cfg.portal_port);
        dbgHexPsk();   // byte-for-byte dump to catch invisible PSK characters
        startNormalMode();
    } else {
        DBGLN("[BOOT] no valid config — entering setup AP mode");
        startSetupMode();
    }
}

void loop() {
    if (isSetupMode) {
        setupServer.handleClient();
        return;
    }

    coinServer.handleClient();

    // Deferred Wi-Fi credential switch requested via /setwifi. Applied a moment
    // after we ACK so the HTTP reply drains and the portal has time to retune
    // the AP onto the new SSID before we drop the old association. The 15s
    // watchdog further below then keeps retrying until the new AP appears.
    // Elapsed-subtraction compare so it stays correct across millis() rollover.
    if (wifiChangePending && (millis() - wifiChangeReqMs) >= WIFI_CHANGE_DELAY_MS) {
        wifiChangePending = false;
        WiFi.disconnect();
        delay(100);
        WiFi.begin(cfg.ssid, cfg.pass);   // new creds already saved to cfg
    }

// --- ANTI-SPARK / EMI HEALING ---
    // Continuously re-assert the coin slot enable pin during an active session.
    // If a piezo spark scrambles the ESP8266's GPIO registers and turns D7 into 
    // an INPUT, this forces it back to an OUTPUT almost instantly.
// --- ANTI-SPARK / EMI HEALING ---
    // FIX: Throttle to once per second. Calling pinMode disables interrupts
    // continuously and can cause the ESP to miss coin pulses!
    static unsigned long lastHealMs = 0;
    if (sessionActive && !finalizing && (millis() - lastHealMs > 1000)) {
        lastHealMs = millis();
        pinMode(COIN_ENABLE_PIN, OUTPUT);
        digitalWrite(COIN_ENABLE_PIN, COIN_ENABLE_ACTIVE);
    }

    // --- LINK-LOSS COUNTDOWN PAUSE ---
    // While a session is open the portal polls /status ~1/s. If those polls go
    // silent the portal/link is down; freeze the coin-insert countdown so the
    // customer doesn't lose their window (and already-inserted coins) to a
    // dropout. We freeze by advancing sessionStartMs in lock-step with millis()
    // every tick, so "elapsed" stops growing. A verified poll clears
    // countdownPaused (see handle_coin_status) and the window resumes intact.
    // Coins may still be inserted while paused (the ISR still counts them and
    // extends the window). If the outage drags on past MAX_PAUSE_MS we stop
    // waiting and finalize, converting the inserted coins into time so they are
    // never stuck.
    {
        unsigned long nowMs = millis();
        if (sessionActive && !finalizing) {
            bool linkStale = (nowMs - lastPollMs) > LINK_STALE_MS;
            if (linkStale && !countdownPaused) {
                countdownPaused = true;
                pauseStartMs = nowMs;
            }
            if (countdownPaused) {
                // Keep the window frozen: consume the delta so elapsed is flat.
                if (lastLoopMs != 0) sessionStartMs += (nowMs - lastLoopMs);
                // Safety valve: don't pause forever. Finalize (grant the coins
                // as time) after MAX_PAUSE_MS of continuous silence.
                if ((nowMs - pauseStartMs) >= MAX_PAUSE_MS) {
                    countdownPaused = false;
                    finalizing = true;
                    setCoinAcceptor(false);
                }
            }
        }
        lastLoopMs = nowMs;
    }

    // PHASE 1: Initiate shutdown (user clicked Done/Cancel OR time ran out naturally)
    if (sessionActive && !finalizing && (cancelRequested || (millis() - sessionStartMs) >= sessionTimeoutMs)) {
        finalizing = true;
        setCoinAcceptor(false); // Instantly block new physical coins from entering the slot
    }

    // PHASE 2: Wait for any currently-dropping coin to finish its pulses
    if (sessionActive && finalizing) {
        // 500ms of absolute silence means the coin has completely passed the sensor
        if (millis() - lastPulseMs > 500) {
            cancelRequested = false;
            finalizing = false;
            endSession(); // Shuts down session natively and posts the full correct amount
        }
    }

    // Retry pending result POST after WiFi recovery (up to 10 attempts, 5s apart)
    if (pendingResult && pendingRetries < 10) {
        static unsigned long lastRetry = 0;
        if (millis() - lastRetry > 5000) {
            lastRetry = millis();
            pendingRetries++;
            post_result();
        }
    }

    // WiFi watchdog — reconnect check every 15s.
    // wrongGwStrikes: tolerate up to 3 consecutive wrong-gateway readings (45s)
    // before forcing re-DHCP, so a slow br0→br1 bridge transition doesn't cause
    // a tight disconnect/reconnect storm that prevents the correct lease arriving.
// ── DYNAMIC FAST-RECOVERY WATCHDOG ──
    // Healthy (connected with correct gateway): check every 15s (low overhead).
    // Unhealthy (disconnected or wrong br0 gateway): check every 3s (fast recovery).
    static unsigned long lastWifiCheck = 0;
    static uint8_t wrongGwStrikes = 0;

    bool isHealthy = (WiFi.status() == WL_CONNECTED) && 
                     (WiFi.gatewayIP() == portalIPAddr);
    unsigned long checkInterval = isHealthy ? 15000UL : 10000UL;

    if (millis() - lastWifiCheck > checkInterval) {
        lastWifiCheck = millis();

        if (WiFi.status() != WL_CONNECTED) {
            wrongGwStrikes = 0;
            WiFi.begin(cfg.ssid, cfg.pass); // Re-trigger scan immediately
        }
        else if (WiFi.gatewayIP() != portalIPAddr) {
            // Wrong gateway (still bridged to br0). Disconnect and re-DHCP
            // after 2 strikes (~6 seconds instead of 45 seconds).
            if (++wrongGwStrikes >= 2) {
                wrongGwStrikes = 0;
                WiFi.disconnect(false);
                delay(100);
                WiFi.begin(cfg.ssid, cfg.pass);
            }
        }
        else {
            wrongGwStrikes = 0; // Correct gateway
        }
    }

    // Scheduled daily reboot + heap watchdog. Defers the actual restart until
    // the machine is idle so an active coin session is never interrupted.
    serviceReboot();

    delay(10);
}
