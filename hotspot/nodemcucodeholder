<label>Password <span style="color:#555">— leave blank if open network</span></label>
<input id="pass" type="password" placeholder="WiFi password" autocomplete="new-password">

<h3>Coin Acceptor</h3>
<label>Shared PSK <span style="color:#555">— must exactly match COIN_PSK in lmehspt.sh</span></label>
<input id="psk" type="text" placeholder="e.g. ReplaceWithSomethingLongAndRandom!">
<div class="row">
  <div><label>Pesos / Pulse</label>
